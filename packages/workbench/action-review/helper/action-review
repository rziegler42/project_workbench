#!/usr/bin/env python3
"""The action-review helper: reviews one command the harness is about to run.

It is one file that imports the standard library; the launcher runs a private copy of it through the kit
runner with nothing beside it.

    action-review review [--log-row] <command text>

The contract is ``docs/specs/action-review.md``. The command text is read once, under a grammar so small that
``sh`` and ``zsh`` read it alike: single-spaced words, each a bare word of a small alphabet or a single-quoted
string. Anything else is unreviewable. The rule found for the text names the module and the action, and the engine asks
that module for ``describe`` through the launcher and reads the object it prints. The checks and the bridge call are
later increments of plan ``2026-10-26-action-review-engine``, so a text that gets this far is still refused for now. A
refusal prints one ``refused:`` line on standard error and nothing on standard output, and exits 1.
"""

import collections
import math
import os
import re
import sys

from wbkit import call, jsonstrict, project, safefs

USAGE = "usage: action-review review [--log-row] <command text>"
MAX_TEXT = 4096
# The installed place of the rule files, below the project root. The helper runs as a private copy with nothing beside
# it, so it cannot find them "beside itself"; like the review setting, they are read from the project.
RULES_DIR = ".workbench/workbench/action-review/rules"
MAX_RULE = 16384
MAX_RULES = 64
MAX_RULES_BYTES = 262144
MAX_ARGUMENTS = 61
FORMAT = 1
FIELDS = ("format", "spelling", "subcommand", "module", "action", "flags", "positionals", "checks", "rubric",
          "questions", "lists")
OPTIONAL = frozenset(("lists",))
# The engine's fixed list of code checks. A rule may name only these; the functions arrive with the checks.
CHECKS = ("head_matches", "repo_config_safe", "staging_state_ok", "paths_valid", "message_valid",
          "paths_not_credentials", "paths_regular", "facts_complete", "no_secret_lines", "confirm_present",
          "removal_valid", "ignore_status_known", "preview_matches_arguments", "no_git_metadata")
LIST_NAMES = ("credential_names", "reviewer_facing_paths")
FLAG_TYPES = ("value", "multi", "boolean")
SPELLING_WORD = re.compile(r"[A-Za-z0-9._/:=@%+,-]{1,64}")
MODULE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}")
ACTION = re.compile(r"[a-z][a-z0-9-]{0,31}")
FLAG = re.compile(r"--[a-z][a-z0-9-]{0,31}")
NAME = re.compile(r"[a-z][a-z0-9_]{0,63}")
# `describe` (decision 2026-10-25-describe-interface-for-action-review): the object and its newline are at most 196,608
# bytes (`safe-git.md`, "Caps and their sources"), and it is given 5 of the review's 25 seconds (spec, "The time budget").
DESCRIBE_LIMIT = 196608
DESCRIBE_SECONDS = 5
CONTRACTS = frozenset((1,))
DESCRIBE_FIELDS = ("contract", "action", "ok", "truncated", "errors", "facts")
ERROR_CODE = re.compile(r"[a-z0-9_]{1,64}")
MAX_MESSAGE = 500
MAX_WHOLE = 2 ** 53 - 1
BARE = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/:=@%+,-")

Word = collections.namedtuple("Word", ("text", "quoted"))


class Unreviewable(Exception):
    """The text does not fit the grammar or a rule, so it is not reviewed and approves nothing."""


class RulesUnavailable(Exception):
    """The rules directory cannot be used at all, so no rule is trusted to match and every review is refused."""


class RuleError(Exception):
    """One rule file does not load. The reason is fixed text and never quotes the file."""


class DescribeFailed(Exception):
    """`describe` did not give an object the engine can use. The reason is fixed text: it never quotes the object, the
    standard error or a field name, because all of them are the repository's text."""


class AnyWord:
    """The `declared` set of the first parse, which finds the rule: every dash word passes, and the second parse,
    with the rule's own flags, refuses the ones it does not declare."""

    def __contains__(self, word):
        return True


def parse_words(text, declared=frozenset()):
    """The words of `text` as ``Word(text, quoted)``, or raise `Unreviewable`.

    The grammar: one or more words, each followed by exactly one space or the end, no leading or trailing space. A
    word is a run of bare characters, or ``'`` any characters but ``'``, newline and NUL ``'``. A bare word that
    begins with ``-`` must be one of `declared` (the words a rule declares, the lone ``--`` among them), and a quoted
    word never begins with ``-``, so a quoted word is never a flag. A bare word that begins with ``=`` (zsh expands
    it to a path) is refused, and so is a first word that holds an equals sign (``A=1``, ``A+=1``), which a shell
    reads as an environment prefix."""
    if not isinstance(text, str):
        raise Unreviewable("the command is not text")
    if not text:
        raise Unreviewable("the command is empty")
    if len(text) > MAX_TEXT:
        raise Unreviewable("the command is longer than %d characters" % MAX_TEXT)
    try:
        text.encode("utf-8")
    except UnicodeEncodeError:
        raise Unreviewable("the command holds a character that is not text") from None
    words = []
    size = len(text)
    at = 0
    while True:
        if at >= size:
            raise Unreviewable("the command ends with a space")
        if text[at] == "'":
            end = text.find("'", at + 1)
            if end < 0:
                raise Unreviewable("a single quote is not closed")
            body = text[at + 1:end]
            if "\n" in body or "\0" in body:
                raise Unreviewable("a quoted word holds a newline or a NUL")
            if body.startswith("-"):
                raise Unreviewable("a quoted word begins with a dash, so it could be read as a flag")
            words.append(Word(body, True))
            at = end + 1
        else:
            end = at
            while end < size and text[end] in BARE:
                end += 1
            if end == at:
                if text[at] == " ":
                    raise Unreviewable("the command has a leading or doubled space")
                raise Unreviewable("the character %s is outside the grammar" % ascii(text[at]))
            body = text[at:end]
            if body.startswith("="):
                raise Unreviewable("a word begins with an equals sign")
            if not words and "=" in body:
                raise Unreviewable("the command begins with an assignment")
            if body.startswith("-") and body not in declared:
                raise Unreviewable("the word %s begins with a dash and is not declared" % ascii(body))
            words.append(Word(body, False))
            at = end
        if at == size:
            return words
        if text[at] != " ":
            raise Unreviewable("the character %s is outside the grammar there" % ascii(text[at]))
        at += 1


def split_command(words, spelling, subcommand):
    """The words after `spelling` and `subcommand`, or ``None`` when `words` do not begin with them. Words are
    compared by value, whole word to whole word: a quoted word reaches the program as the same argument."""
    count = len(spelling)
    if len(words) <= count:
        return None
    if tuple(w.text for w in words[:count]) != tuple(spelling) or words[count].text != subcommand:
        return None
    return list(words[count + 1:])


Flag = collections.namedtuple("Flag", ("type", "required"))
Group = collections.namedtuple("Group", ("name", "separator", "min", "max"))
Rule = collections.namedtuple("Rule", ("file", "spelling", "subcommand", "module", "action", "flags", "positionals",
                                       "checks", "rubric", "questions", "lists"))
# A file that did not load, or shares its key: `key` is its spelling and subcommand words when both are valid, else
# None, and then `stem` (the file name without ``.json``) is matched against the command's first words.
Blocked = collections.namedtuple("Blocked", ("file", "key", "stem"))
Loaded = collections.namedtuple("Loaded", ("rules", "errors", "blocked"))


def _text(value, pattern):
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise RuleError("a field is not in its form")
    return value


def _names(value, limit, pattern=None, allowed=None):
    """A list of at most `limit` distinct strings, each in `pattern` or in `allowed`."""
    if not isinstance(value, list) or len(value) > limit:
        raise RuleError("a list is not a list of at most %d entries" % limit)
    for item in value:
        if allowed is not None:
            if item not in allowed:
                raise RuleError("a list names something that is not in the engine's fixed list")
        else:
            _text(item, pattern)
    if len(set(value)) != len(value):
        raise RuleError("a list repeats an entry")
    return tuple(value)


def _spelling(value):
    if not isinstance(value, list) or not 1 <= len(value) <= 4:
        raise RuleError("the spelling is not a list of one to four words")
    for index, word in enumerate(value):
        _text(word, SPELLING_WORD)
        if word.startswith(("-", "=")) or (index == 0 and "=" in word):
            raise RuleError("the spelling holds a word that could be read as a flag or an assignment")
    return tuple(value)


def _key(body):
    """The spelling and subcommand of a rule document as one tuple, or None when either is not valid."""
    try:
        return _spelling(body.get("spelling")) + (_text(body.get("subcommand"), ACTION),)
    except RuleError:
        return None


def _flags(value):
    if not isinstance(value, dict) or len(value) > 32:
        raise RuleError("the flags are not an object of at most 32 entries")
    flags = {}
    for name, spec in value.items():
        _text(name, FLAG)
        if not isinstance(spec, dict) or not set(spec) <= {"type", "required"} or spec.get("type") not in FLAG_TYPES:
            raise RuleError("a flag is not a type of value, multi or boolean, with an optional required")
        required = spec.get("required", False)
        if type(required) is not bool:
            raise RuleError("a flag's required is not true or false")
        flags[name] = Flag(spec["type"], required)
    return flags


def _positionals(value):
    if not isinstance(value, dict) or set(value) != {"name", "separator", "min", "max"}:
        raise RuleError("the positionals are not exactly one group of name, separator, min and max")
    low, high = value["min"], value["max"]
    for number in (low, high):
        if type(number) is not int or not 0 <= number <= MAX_ARGUMENTS:
            raise RuleError("a count of positionals is not a whole number from 0 to %d" % MAX_ARGUMENTS)
    if low > high or type(value["separator"]) is not bool:
        raise RuleError("the group's min exceeds its max, or its separator is not true or false")
    return Group(_text(value["name"], ACTION), value["separator"], low, high)


def _lists(value):
    if not isinstance(value, dict):
        raise RuleError("the lists are not an object")
    lists = {}
    for name, items in value.items():
        if name not in LIST_NAMES or not isinstance(items, list) or len(items) > 256:
            raise RuleError("a list is not one the engine knows, of at most 256 entries")
        for item in items:
            if not isinstance(item, str) or not 1 <= len(item) <= 256 or not all(" " <= c <= "~" for c in item):
                raise RuleError("a list entry is not printable ASCII of 1 to 256 characters")
        if len(set(items)) != len(items):
            raise RuleError("a list repeats an entry")
        lists[name] = tuple(items)
    return lists


def build_rule(name, body):
    """The `Rule` that the document `body` of the file `name` describes, or `RuleError`."""
    if not set(body) <= set(FIELDS):
        raise RuleError("it has a field that is not in the schema")
    for field in FIELDS:
        if field not in body and field not in OPTIONAL:
            raise RuleError("the field %s is missing" % field)
    if type(body["format"]) is not int or body["format"] != FORMAT:
        raise RuleError("the format is not %d" % FORMAT)
    spelling = _spelling(body["spelling"])
    subcommand, module, action = (_text(body["subcommand"], ACTION), _text(body["module"], MODULE),
                                  _text(body["action"], ACTION))
    if subcommand != action:
        raise RuleError("the subcommand is not the action")
    if spelling[:2] == ("wb", "run") and spelling[-1] != module:
        raise RuleError("a wb run spelling does not end with the module")
    if name != "%s-%s.json" % (module, action):
        raise RuleError("the file name is not <module>-<action>.json")
    return Rule(name, spelling, subcommand, module, action, _flags(body["flags"]), _positionals(body["positionals"]),
                _names(body["checks"], 32, allowed=CHECKS), _text(body["rubric"], NAME),
                _names(body["questions"], 16, NAME), _lists(body["lists"]) if "lists" in body else None)


def load_rules(root):
    """Every rule file under `root`: a `Loaded` of the rules that load, the errors by file name, and the keys that no
    command may use because a file for them does not load or two files share them. `RulesUnavailable` when the
    directory cannot be read or holds too much."""
    rules, errors, blocked = [], [], []
    try:
        with safefs.Root(root, "project root") as tree:
            entries = tree.list_dir(RULES_DIR, lenient=True)
            if entries is None:
                raise RulesUnavailable("the rules directory is missing")
            if len(entries) > MAX_RULES:
                raise RulesUnavailable("the rules directory holds more than %d files" % MAX_RULES)
            total = 0
            for name, kind in entries:
                if not name.endswith(".json"):
                    continue
                key = None
                try:
                    if kind != "file":
                        raise RuleError("it is not a regular file")
                    try:
                        data = tree.read_if_present(RULES_DIR + "/" + name, MAX_RULE)
                    except safefs.SafeFsError:
                        raise RuleError("it cannot be read, has another link or is larger than %d bytes"
                                        % MAX_RULE) from None
                    if data is None:
                        raise RuleError("it disappeared while it was read")
                    total += len(data)
                    if total > MAX_RULES_BYTES:
                        raise RulesUnavailable("the rules hold more than %d bytes" % MAX_RULES_BYTES)
                    try:
                        body = jsonstrict.parse_object(data, MAX_RULE)
                    except ValueError:
                        raise RuleError("it is not strict JSON") from None
                    key = _key(body)
                    rules.append(build_rule(name, body))
                except RuleError as exc:
                    errors.append((name, str(exc)))
                    blocked.append(Blocked(name, key, name[:-len(".json")]))
    except safefs.SafeFsError:
        raise RulesUnavailable("the rules directory cannot be read") from None
    taken = collections.Counter(rule.spelling + (rule.subcommand,) for rule in rules)
    kept = []
    for rule in rules:
        key = rule.spelling + (rule.subcommand,)
        if taken[key] > 1:
            errors.append((rule.file, "another rule has the same command"))
            blocked.append(Blocked(rule.file, key, rule.file[:-len(".json")]))
        else:
            kept.append(rule)
    return Loaded(kept, sorted(errors), blocked)


def _blocks(entry, words):
    texts = [w.text for w in words]
    if entry.key is not None:
        return split_command(words, entry.key[:-1], entry.key[-1]) is not None
    return any("-".join(pair) == entry.stem for pair in zip(texts[:5], texts[1:5]))


def find_rule(loaded, words):
    """The one rule that reviews `words`, or `Unreviewable`. A file that does not load, or shares its key, refuses
    the commands of its key; two rules that both match refuse the command."""
    stuck = sorted(entry.file for entry in loaded.blocked if _blocks(entry, words))
    if stuck:
        raise Unreviewable("the rule file%s %s cannot be used, so the command is not reviewed"
                           % ("" if len(stuck) == 1 else "s", ", ".join(ascii(name) for name in stuck)))
    hits = [rule for rule in loaded.rules if split_command(words, rule.spelling, rule.subcommand) is not None]
    if len(hits) > 1:
        raise Unreviewable("more than one rule matches (%s), so the command is not reviewed"
                           % ", ".join(ascii(rule.file) for rule in sorted(hits, key=lambda r: r.file)))
    if not hits:
        raise Unreviewable("no rule matches this command")
    return hits[0]


def parse_arguments(rule, rest):
    """Check that the `Word`s `rest`, after the rule's spelling and subcommand, fit its flags and positionals, and
    return them as texts in the order given. The shape only: the real validation is `describe`'s."""
    if len(rest) > MAX_ARGUMENTS:
        raise Unreviewable("the command has more than %d arguments" % MAX_ARGUMENTS)
    group, seen, at = rule.positionals, set(), 0
    while at < len(rest):
        word = rest[at]
        if not word.quoted and word.text == "--":
            break
        if word.quoted or not word.text.startswith("-"):
            if group.separator:
                raise Unreviewable("the word %s is where a flag is expected" % ascii(word.text)[:80])
            break
        flag = rule.flags.get(word.text)
        if flag is None:
            raise Unreviewable("the flag %s is not declared" % ascii(word.text)[:80])
        if flag.type != "multi" and word.text in seen:
            raise Unreviewable("the flag %s is given more than once" % word.text)
        seen.add(word.text)
        at += 1
        if flag.type != "boolean":
            if at >= len(rest) or (not rest[at].quoted and rest[at].text.startswith("-")):
                raise Unreviewable("the flag %s needs a value" % word.text)
            at += 1
    for name in sorted(rule.flags):
        if rule.flags[name].required and name not in seen:
            raise Unreviewable("the flag %s is required" % name)
    if group.separator:
        if at >= len(rest):
            raise Unreviewable("the separator -- is missing")
        at += 1
    positional = rest[at:]
    for word in positional:
        if not word.quoted and word.text == "--":
            raise Unreviewable("a second -- word is not allowed")
        if not word.quoted and word.text in rule.flags:
            raise Unreviewable("a flag word comes after the positional words begin")
    if len(positional) < group.min:
        raise Unreviewable("the command needs at least %d %s" % (group.min, group.name))
    if len(positional) > group.max:
        raise Unreviewable("the command takes at most %d %s" % (group.max, group.name))
    return [word.text for word in rest]


def read_command(loaded, text):
    """``(rule, arguments)`` for the command `text`, or `Unreviewable`. The text is parsed twice: once to find the rule,
    letting any dash word through, and again with only the rule's own flags (and the separator) declared."""
    rule = find_rule(loaded, parse_words(text, AnyWord()))
    declared = frozenset(rule.flags) | ({"--"} if rule.positionals.separator else frozenset())
    words = parse_words(text, declared)
    return rule, parse_arguments(rule, split_command(words, rule.spelling, rule.subcommand))


def _error_entry(item):
    if not isinstance(item, dict) or set(item) != {"code", "message"} or not isinstance(item["code"], str) \
            or not isinstance(item["message"], str):
        raise DescribeFailed("an error entry is not an object with a code and a message and nothing else")
    if not ERROR_CODE.fullmatch(item["code"]):
        raise DescribeFailed("an error code is not 1 to 64 characters of a-z, 0-9 and _")
    if len(item["message"]) > MAX_MESSAGE:
        raise DescribeFailed("an error message is longer than %d characters" % MAX_MESSAGE)


def _whole_or_text(value):
    """Whether `value` is one the decision allows as a fact: text, a whole number from 0 to 2^53 - 1, a boolean, null
    or a list of text. A boolean is not a number here."""
    if value is None or isinstance(value, (bool, str)):
        return True
    if type(value) is int:
        return 0 <= value <= MAX_WHOLE
    return isinstance(value, list) and all(isinstance(item, str) for item in value)


def read_description(data, action):
    """The `describe` object in `data`, the standard output of the call, as a dict, or raise `DescribeFailed`.

    The field rules are those of the accepted decision: one JSON object on one line, exactly the six fields,
    a `contract` the engine knows, `action` equal to `action`, booleans `ok` and `truncated`, `errors` as a list of
    entries of exactly a `code` and a `message`, `ok` true only with no error, and `facts` a flat object. An object
    that says `ok: false` or `truncated: true` is well formed and is returned; deciding what that means is the
    checks' work, not this function's."""
    if not isinstance(data, bytes):
        raise DescribeFailed("the output is not bytes")
    if len(data) > DESCRIBE_LIMIT:
        raise DescribeFailed("the output is larger than %d bytes" % DESCRIBE_LIMIT)
    body = data[:-1] if data.endswith(b"\n") else data
    if b"\n" in body:
        raise DescribeFailed("the output is not a single line")
    if not (body.startswith(b"{") and body.endswith(b"}")):
        raise DescribeFailed("the output is not one object")
    try:
        document = jsonstrict.parse_object(body, DESCRIBE_LIMIT)
    except ValueError as exc:
        raise DescribeFailed("the object is not strict JSON: %s" % exc) from None
    for name in DESCRIBE_FIELDS:
        if name not in document:
            raise DescribeFailed("the field %s is missing" % name)
    if set(document) - set(DESCRIBE_FIELDS):
        raise DescribeFailed("the object has a field that is not part of the contract")
    if type(document["contract"]) is not int or document["contract"] not in CONTRACTS:
        raise DescribeFailed("the field contract is not a contract number the engine knows")
    if not isinstance(document["action"], str) or document["action"] != action:
        raise DescribeFailed("the field action is not the action requested")
    for name in ("ok", "truncated"):
        if type(document[name]) is not bool:
            raise DescribeFailed("the field %s is not a boolean" % name)
    if not isinstance(document["errors"], list):
        raise DescribeFailed("the field errors is not a list")
    for item in document["errors"]:
        _error_entry(item)
    if document["ok"] and document["errors"]:
        raise DescribeFailed("ok is true but errors is not empty")
    if not isinstance(document["facts"], dict):
        raise DescribeFailed("the field facts is not an object")
    for name, value in document["facts"].items():
        if not NAME.fullmatch(name):
            raise DescribeFailed("a fact name is not lowercase letters, digits and underscores from a letter")
        if not _whole_or_text(value):
            raise DescribeFailed("a fact value is not text, a whole number from 0 to 2^53 - 1, a boolean, null or a "
                                 "list of text")
    return document


def describe(root, rule, arguments, cwd):
    """The object `wb run <module> describe <action> <arguments>` prints, run from `cwd`. The command is the rule's
    module and the fixed word `describe` and the rule's action, and the arguments are the parsed ones; they reach the
    launcher as a list, with no shell. The launcher refuses a command that is not installed, declared and pinned, and
    that refusal is a failed call here like any other. Raises `DescribeFailed`; what the call printed on standard error
    is not shown."""
    try:
        got = call.run_command(root, rule.module, ["describe", rule.action] + list(arguments),
                               limit=DESCRIBE_LIMIT, timeout=DESCRIBE_SECONDS, cwd=cwd)
    except call.CallError:
        raise DescribeFailed("describe could not be started") from None
    if got.timed_out:
        raise DescribeFailed("describe did not finish in %d seconds" % DESCRIBE_SECONDS)
    if got.over:
        raise DescribeFailed("describe printed an output larger than %d bytes" % DESCRIBE_LIMIT)
    if got.code != 0:
        raise DescribeFailed("describe was refused or failed (exit %d)" % got.code)
    return read_description(got.stdout, rule.action)


# -- the code checks ------------------------------------------------------------------------------------------------
# A check is a pure function of the `describe` object (and, for one, of a list the rule carries). The secret scan and the
# credential names are those of the owner's approver, ported by plan `2026-10-26-action-review-engine`, increment F; the
# names live in the rule data. Nothing here returns, prints or raises the text a pattern matched.

SECRET_PATTERNS = tuple(re.compile(pattern) for pattern in (
    r"-----BEGIN\s+[A-Z ]*PRIVATE\s+KEY-----",
    r"AKIA[0-9A-Z]{16}",
    r"gh[pousr]_[A-Za-z0-9]{30,}",
    r"xox[baprs]-[A-Za-z0-9-]{10,}",
    r"\bsk-[A-Za-z0-9]{20,}",
    r"\bsk_(live|test)_[0-9A-Za-z]{16,}",
    r"\bglpat-[A-Za-z0-9_-]{20,}",
    r"\bnpm_[A-Za-z0-9]{30,}",
    r"AIza[0-9A-Za-z_-]{35}",
    r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}",
    r"(?i)\b(basic|bearer)\s+[A-Za-z0-9._~+/=-]{16,}",
    r"(?i)(password|passwd|secret|api[_-]?key|token)\s*[:=]\s*['\"][^'\"\s]{8,}['\"]",
    r"(?i)(password|passwd|pwd|secret|token|api[_-]?key)[\"']?\s*[:=]\s*[\"']?[A-Za-z0-9+/=_-]{12,}(?![A-Za-z0-9+/=_.(-])",
    r"(?i)(aws_secret_access_key|secret_access_key|client_secret|private_key)\s*[:=]\s*\S{8,}",
    r"[a-z][a-z0-9+.-]*://[^/\s:@]+:[^/\s@]+@",
))
GENERIC_ASSIGNMENT_PATTERNS = frozenset(SECRET_PATTERNS[11:13])  # password|secret|token|api_key = "value"
TOKEN_RE = re.compile(r"[A-Za-z0-9+/=_-]{24,}")
HEX_RE = re.compile(r"[0-9a-fA-F]+")
CHECKSUM_CONTEXT = re.compile(r"(?i)sha-?(1|256|384|512)|integrity|checksum|digest|\bhash\b|\bmd5\b|\bgo\.sum\b")
INTEGRITY_RE = re.compile(
    r"sha1-[A-Za-z0-9+/]{27}=|sha256-[A-Za-z0-9+/]{43}=|sha384-[A-Za-z0-9+/]{64}|sha512-[A-Za-z0-9+/]{86}==")
JOB_ID_RE = re.compile(r"[a-z0-9]+(?:--[a-z0-9]+)*--\d{8}-\d{6}--[0-9a-f]{8}")
WORDY_SEGMENT_RE = re.compile(r"[A-Za-z_.-]{3,}")
COMPOUND_PART_RE = re.compile(r"[a-z]{1,24}|[A-Z]{1,24}|[A-Z][a-z]{1,23}|\d{1,6}")
SEGMENT_MIN = 16
LOCKFILES = frozenset((
    "package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml", "Cargo.lock", "go.sum", "poetry.lock",
    "uv.lock", "Pipfile.lock", "composer.lock", "Gemfile.lock", "flake.lock"))
TEST_DIRECTORIES = frozenset(("tests", "test", "__tests__"))
PERCENT_RUN = re.compile(r"(?:%[0-9A-Fa-f]{2})+")
HUNK = re.compile(r"@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
NO_NEWLINE = "\\ No newline at end of file"


def _entropy(token):
    counts = {}
    for char in token:
        counts[char] = counts.get(char, 0) + 1
    return -sum(n / len(token) * math.log2(n / len(token)) for n in counts.values())


def _word_compound(token):
    """An identifier or file stem of plain words and short numbers joined by `_` or `-` (at least two joins)."""
    parts = re.split(r"[_-]+", token.strip("_-"))
    return len(parts) >= 3 and all(COMPOUND_PART_RE.fullmatch(part) for part in parts)


def _suspect(token):
    """Random-looking: long hex (a 40-character Git object id is exempt), or a mixed token with high entropy."""
    if HEX_RE.fullmatch(token):
        return len(token) >= 32 and len(token) != 40
    if _word_compound(token):
        return False
    mixed = any(c.isdigit() for c in token) and any(c.isalpha() for c in token)
    entropy = _entropy(token)
    return entropy >= 4.0 if len(token) >= 40 else (mixed and entropy >= 3.8)


def _path_segments(token):
    """The segments of a path-like token, else None: two or more, with at least half of them plain words."""
    segments = [part for part in token.split("/") if part]
    if len(segments) < 2 or "/" not in token or "=" in token or "+" in token:
        return None
    wordy = sum(1 for part in segments if WORDY_SEGMENT_RE.fullmatch(part))
    return segments if wordy * 2 >= len(segments) else None


def _token_kind(token):
    if JOB_ID_RE.fullmatch(token):
        return None
    segments = _path_segments(token)
    if segments is not None:
        if any(len(part) >= SEGMENT_MIN and _suspect(part) for part in segments):
            return "long_hex" if any(HEX_RE.fullmatch(p) and len(p) >= 32 for p in segments) else "high_entropy"
        return None
    if not _suspect(token):
        return None
    return "long_hex" if HEX_RE.fullmatch(token) else "high_entropy"


def _entropy_kind(text):
    """The first random-looking kind in the text, else None. A hex digest or a `shaN-` integrity value is skipped on a
    line that talks about checksums, and a bare digest on the line after one."""
    previous = ""
    for line in text.splitlines():
        marker = line[:1] if line[:1] in "+- " else ""
        body = line[1:] if marker else line
        context_here = bool(CHECKSUM_CONTEXT.search(line))
        context_before = bool(CHECKSUM_CONTEXT.search(previous))
        previous = line
        for match in TOKEN_RE.finditer(body):
            token = match.group()
            kind = _token_kind(token)
            if kind is None:
                continue
            if context_here and (HEX_RE.fullmatch(token) or INTEGRITY_RE.fullmatch(token)):
                continue
            if kind == "long_hex" and context_before and HEX_RE.fullmatch(token):
                continue
            return kind
    return None


def _decoded(text):
    """The text with %XX and \\uXXXX escapes decoded, so an encoded secret is seen whole."""
    unescaped = re.sub(r"\\u([0-9a-fA-F]{4})", lambda m: chr(int(m.group(1), 16)), text)
    return PERCENT_RUN.sub(lambda m: bytes.fromhex(m.group().replace("%", "")).decode("utf-8", "replace"), unescaped)


def secret_kind(text, entropy=True, relaxed=False):
    """The kind of the first secret shape in the text ("pattern", "long_hex" or "high_entropy"), else None, never the
    text. The patterns run on the text, on the text with each line's diff marker removed and on the decoded text.
    `entropy` false skips the random-looking-token check; `relaxed` skips the generic assignment patterns."""
    plain = "\n".join(line[1:] if line[:1] in "+- " else line for line in text.splitlines())
    decoded = _decoded(text)
    patterns = [p for p in SECRET_PATTERNS if not (relaxed and p in GENERIC_ASSIGNMENT_PATTERNS)]
    if any(pattern.search(candidate) for pattern in patterns for candidate in (text, plain, decoded)):
        return "pattern"
    return (_entropy_kind(text) or _entropy_kind(decoded)) if entropy else None


def _scan_options(path):
    """How to scan one file's diff. A lock file carries hashes and long names by design, so only its entropy check is
    skipped; a test directory carries fixture credentials, so only the generic assignment patterns are relaxed."""
    parts = path.split("/")
    return {"entropy": parts[-1] not in LOCKFILES, "relaxed": any(part in TEST_DIRECTORIES for part in parts[:-1])}


def _diff_sections(diff):
    """The diff of `safe-git describe` as a list of `(path or None, text)`, or None when its shape is not exactly that
    of the helper: the files' headers, hunks whose counted lines are read as lines whatever they look like, and mode
    lines. A line inside a hunk is never a header, so a file cannot pose as another to be scanned under its options."""
    lines = diff.split("\n")
    if lines.pop() != "":
        return None
    sections, index = [], 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("mode HEAD/"):
            sections.append((None, line + "\n"))
            index += 1
            continue
        if not line.startswith("--- HEAD/") or index + 1 >= len(lines):
            return None
        path = line[len("--- HEAD/"):]
        if lines[index + 1] != "+++ work/" + path:
            return None
        start, index = index, index + 2
        while index < len(lines) and lines[index].startswith("@@ "):
            hunk = HUNK.fullmatch(lines[index])
            if hunk is None:
                return None
            if max(len(group or "") for group in hunk.groups()) > 9:
                return None
            old, new = (1 if hunk[2] is None else int(hunk[2])), (1 if hunk[4] is None else int(hunk[4]))
            index += 1
            while old or new:
                if index >= len(lines):
                    return None
                marker = lines[index][:1]
                if lines[index] == NO_NEWLINE:
                    pass
                elif marker == " " and old and new:
                    old, new = old - 1, new - 1
                elif marker == "-" and old:
                    old -= 1
                elif marker == "+" and new:
                    new -= 1
                else:
                    return None
                index += 1
            while index < len(lines) and lines[index] == NO_NEWLINE:
                index += 1
        sections.append((path, "\n".join(lines[start:index]) + "\n"))
    return sections


def diff_secret_kind(diff):
    """The kind of the first secret shape in the diff, else None. Each file is scanned under its own options; a diff
    whose shape is not understood is scanned as a whole under none."""
    sections = _diff_sections(diff)
    if sections is None:
        return secret_kind(diff)
    for path, text in sections:
        kind = secret_kind(text) if path is None else secret_kind(text, **_scan_options(path))
        if kind:
            return kind
    return None


def credential_path(path, names):
    """Whether the path names a credential by the list `names`, in any case. An entry that ends with `/` is a directory
    name, matched against any directory above the file. Any other entry is matched against the final segment: whole, as
    a glob where it holds `*`, and as an ending where it begins with `.` (an extension such as `.pem`)."""
    parts = path.lower().split("/")
    name, folders = parts[-1], "/" + "/".join(parts[:-1]) + "/"
    for entry in names:
        entry = entry.lower()
        if entry.endswith("/"):
            found = "/" + entry in folders
        elif "*" in entry:
            found = re.fullmatch(".*".join(re.escape(piece) for piece in entry.split("*")), name, re.S) is not None
        else:
            found = name == entry or (entry.startswith(".") and name.endswith(entry))
        if found:
            return True
    return False


# The check each error code of `describe commit` fails (spec, "The checks"). A code that is not here fails
# `facts_complete`, and so does a code whose check the rule does not name.
ERROR_CHECKS = {"commit": dict(
    [(code, "head_matches") for code in ("expected_head_invalid", "head_mismatch", "head_unreadable")]
    + [(code, "repo_config_safe") for code in ("repo_selects_program", "operation_in_progress")]
    + [(code, "staging_state_ok") for code in ("index_has_staged_changes", "path_already_staged")]
    + [(code, "paths_valid") for code in (
        "usage", "path_refused", "path_duplicate", "path_unmerged", "path_in_nested_repository", "path_not_a_file",
        "path_unknown", "path_converts_on_add", "whitespace_errors")]
    + [(code, "message_valid") for code in (
        "subject_invalid", "body_invalid", "trailer_invalid", "message_character_refused", "attribution_refused",
        "setting_invalid")]
    + [(code, "facts_complete") for code in ("repository_unreadable", "index_unreadable")])}


class Absent(Exception):
    """A fact that a check reads is not in the object, or is not of the type the check reads."""


def _fact(document, name, kind):
    """The fact `name` as `kind` ("text", "text?", "flag" or "texts"), or `Absent`. An object that is not ok holds null
    for a text or flag it could not find out, and that is nothing to read."""
    facts = document["facts"]
    if name not in facts:
        raise Absent()
    value = facts[name]
    if value is None and kind != "texts" and (kind == "text?" or not document["ok"]):
        return None if kind == "text?" else "" if kind == "text" else False
    if kind in ("text", "text?"):
        valid = type(value) is str
    elif kind == "flag":
        valid = type(value) is bool
    else:
        valid = type(value) is list and all(type(item) is str for item in value)
    if not valid:
        raise Absent()
    return value


def _head_matches(rule, document):
    head, expected = _fact(document, "head", "text?"), _fact(document, "expected_head", "text?")
    return expected == "none" if head is None else head == expected


def _repo_config_safe(rule, document):
    return not _fact(document, "program_findings", "texts")


def _staging_state_ok(rule, document):
    staged, leave = _fact(document, "staged_paths", "texts"), _fact(document, "leave_other_staged", "flag")
    return not staged or leave


def _paths_not_credentials(rule, document):
    names = (rule.lists or {}).get("credential_names")
    paths = _fact(document, "requested_paths", "texts") + _fact(document, "paths", "texts")
    if names is None:
        return False
    return not any(credential_path(path, names) for path in paths)


def _paths_regular(rule, document):
    return not _fact(document, "not_regular_paths", "texts")


def _facts_complete(rule, document):
    return not document["truncated"] and not _fact(document, "binary_paths", "texts")


def _no_secret_lines(rule, document):
    subject, body = _fact(document, "subject", "text"), _fact(document, "body", "text?")
    trailers, diff = _fact(document, "trailers", "texts"), _fact(document, "diff", "text")
    return not (secret_kind("\n".join([subject, body or "", *trailers])) or diff_secret_kind(diff))


def _errors_decide(rule, document):
    return True


# The checks that the object's error codes alone decide, and the rest, by name. The order of the engine's list (CHECKS),
# not the rule's, is the order they run in.
CHECK_FUNCTIONS = {
    "head_matches": _head_matches, "repo_config_safe": _repo_config_safe, "staging_state_ok": _staging_state_ok,
    "paths_valid": _errors_decide, "message_valid": _errors_decide, "paths_not_credentials": _paths_not_credentials,
    "paths_regular": _paths_regular, "facts_complete": _facts_complete, "no_secret_lines": _no_secret_lines,
}


def run_checks(rule, document):
    """The names, in the order of `CHECKS`, of the checks of the rule that the `describe` object fails. An error code
    fails the check it maps to; a code that maps to no check of the rule, an object that is not ok and names no error,
    and a fact that is missing or of the wrong type fail `facts_complete`. A check of the rule with no function here
    fails and names itself, so it can never pass by being unwritten."""
    failed, incomplete = set(), False
    for name in CHECKS:
        if name not in rule.checks:
            continue
        function = CHECK_FUNCTIONS.get(name)
        try:
            passed = function is not None and function(rule, document)
        except Absent:
            passed, incomplete = False, True
        if not passed:
            failed.add(name)
    codes = [item["code"] for item in document["errors"]]
    for code in codes:
        name = ERROR_CHECKS.get(rule.action, {}).get(code)
        if name in rule.checks:
            failed.add(name)
        else:
            incomplete = True
    if not document["ok"] and not codes:
        incomplete = True
    if incomplete:
        failed.add("facts_complete")
    return tuple(name for name in CHECKS if name in failed)


def run(argv, cwd, notes):
    """Check the arguments and the text, find the rule and ask for `describe`; return the refusal text and append the
    rule errors to `notes`. The checks and the bridge are not built yet."""
    if not argv or argv[0] != "review":
        return USAGE
    rest = argv[1:]
    if rest[:1] == ["--log-row"]:
        rest = rest[1:]
    if len(rest) != 1:
        return USAGE
    try:
        parse_words(rest[0], AnyWord())
    except Unreviewable as exc:
        return "unreviewable: %s" % exc
    try:
        try:
            root = project.find_root(cwd)
        except project.ProjectError:
            raise RulesUnavailable("the command is not run inside a workbench project") from None
        loaded = load_rules(root)
    except RulesUnavailable as exc:
        return "no rule is trusted: %s" % exc
    notes.extend("rule error: %s: %s" % (ascii(name), why) for name, why in loaded.errors)
    try:
        rule, arguments = read_command(loaded, rest[0])
    except Unreviewable as exc:
        return "unreviewable: %s" % exc
    try:
        describe(root, rule, arguments, cwd)
    except DescribeFailed as exc:
        return "describe: %s" % exc
    return "the engine is not built yet; " + USAGE


def main(argv, stdin, out, err, cwd):
    """Run one command from `cwd`. Returns the exit code."""
    notes = []
    refusal = run(argv, cwd, notes)
    for line in notes:
        err.write(line + "\n")
    err.write("refused: %s\n" % refusal)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdin.buffer, sys.stdout, sys.stderr, os.getcwd()))
