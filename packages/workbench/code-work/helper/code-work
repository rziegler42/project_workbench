#!/usr/bin/env python3
"""The code-work helper: reads a project's plans and says what is wrong with them.

It is one file that imports only the standard library, because the launcher runs a private copy of
it with nothing beside it. It changes nothing, takes no lock, runs no program and follows no link.

    code-work check      report problems with the plans in docs/plans/ (exit 1 if there is one)

The rules are in ``docs/specs/code-work.md`` and in the README the module writes into
``docs/plans/``. Everything read is untrusted repository content: the number of files, the bytes in
all, the bytes of one plan and the findings reported are bounded, and passing a bound is itself a
problem that says what was not looked at. Nothing read is evaluated, and anything shown has its
escapes and non-ASCII characters written out.
"""

import datetime
import io
import itertools
import os
import re
import stat
import sys

MAX_FILES = 2000
MAX_BYTES = 4 * 1024 * 1024
MAX_DOCUMENT = 1024 * 1024
MAX_LISTED = 20000
MAX_HEADER = 40
MAX_INCREMENTS = 1000
MAX_REPORTED = 200
MAX_DEPTH = 64
WARN_INCREMENTS = 15
LIMIT_INCREMENTS = 26

STATUSES = ("Proposed", "Approved", "In Progress", "Completed", "Superseded")
PLANS = "docs/plans"
MANIFEST = ".workbench/manifest.json"

_SLUG = r"[a-z0-9]+(?:-[a-z0-9]+)*"
_NAME = re.compile(r"\A([0-9]{4})-([0-9]{2})-([0-9]{2})-(%s)\.md\Z" % _SLUG)
_DATE = re.compile(r"\A([0-9]{4})-([0-9]{2})-([0-9]{2})\Z")
_ITEM = r"(?:(?:[-*+]|[0-9]{1,9}[.)])[ \t]+)?"
_FENCE = re.compile(r"\A[ ]{0,3}" + _ITEM + r"(`{3,}|~{3,})")
_QUOTE = re.compile(r"\A[ ]{0,3}>")
_TWO = re.compile(r"\A[ ]{0,3}##[ \t]+(.*)")
_TITLE = re.compile(r"\A[ ]{0,3}#[ \t]+\S")
_FIELD = re.compile(r"\A[ ]{0,3}(Status|Created|Candidate|Specs):[ \t]*(.*)\Z")
_CANDIDATE = re.compile(r"\A(%s)#(%s)\Z" % (_SLUG, _SLUG))
_NONE = re.compile(r"\Anone(?:\Z|[ \t,.;:(—-]+(.*))", re.S)
_LABEL = r"[A-Z]{1,3}(?:-[A-Z]{1,3})*"
_INCREMENT = re.compile(r"\A###[ ]Increment[ ](%s)[ ]—[ ]\S.*\Z" % _LABEL)
_NEAR = re.compile(r"\A[ ]{0,3}#{1,6}[ \t]+Increment\b", re.I)
_LINE = 2000


class Refused(Exception):
    """Nothing was looked at; the message says why."""


def shown(text, limit=120):
    """`text` with every character outside printable ASCII written as an escape, cut to `limit`."""
    out = []
    for char in str(text)[:limit]:
        if " " <= char <= "~":
            out.append(char)
        elif ord(char) < 0x100:
            out.append("\\x%02x" % ord(char))
        elif ord(char) < 0x10000:
            out.append("\\u%04x" % ord(char))
        else:
            out.append("\\U%08x" % ord(char))
    return "".join(out)


# --- reading a project without following a link ------------------------------------------------

_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
_FILE = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)


def find_root(start):
    """The nearest directory at or above `start` that holds `.git` and a regular manifest."""
    here = start
    for _ in range(MAX_DEPTH):
        try:
            git = os.lstat(os.path.join(here, ".git"))
            if not stat.S_ISDIR(os.lstat(os.path.join(here, ".workbench")).st_mode):
                raise OSError("not a directory")
            manifest = os.lstat(os.path.join(here, *MANIFEST.split("/")))
        except OSError:
            git = manifest = None
        if git is not None and manifest is not None and stat.S_ISDIR(git.st_mode) \
                and stat.S_ISREG(manifest.st_mode):
            return here
        parent = os.path.dirname(here)
        if parent == here:
            break
        here = parent
    raise Refused("this is not inside a workbench project (no .git with %s above %s)"
                  % (MANIFEST, shown(start)))


def open_dir(root_fd, relative):
    """A descriptor for the directory `relative` below `root_fd`, or None when a part is absent.
    A link or a file on the way is an error."""
    fd = os.dup(root_fd)
    try:
        for part in relative.split("/"):
            try:
                step = os.open(part, _DIR, dir_fd=fd)
            except FileNotFoundError:
                return None
            os.close(fd)
            fd = step
        taken, fd = fd, -1
        return taken
    finally:
        if fd >= 0:
            os.close(fd)


def list_dir(fd):
    """``([(name, kind)], cut)``; `kind` is ``file``, ``dir`` or ``other``. At most MAX_LISTED."""
    found, cut = [], False
    with os.scandir(fd) as entries:
        for entry in entries:
            if len(found) >= MAX_LISTED:
                cut = True
                break
            try:
                mode = entry.stat(follow_symlinks=False).st_mode
            except OSError:
                found.append((entry.name, "other"))
                continue
            kind = "file" if stat.S_ISREG(mode) else "dir" if stat.S_ISDIR(mode) else "other"
            found.append((entry.name, kind))
    return sorted(found), cut


def read_file(dir_fd, name, limit):
    """``(bytes, size)``: at most `limit` bytes of the regular file `name`, and its size."""
    fd = os.open(name, _FILE, dir_fd=dir_fd)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError("not a regular file")
        chunks, taken = [], 0
        while taken < limit:
            piece = os.read(fd, min(65536, limit - taken))
            if not piece:
                break
            chunks.append(piece)
            taken += len(piece)
        return b"".join(chunks), info.st_size
    finally:
        os.close(fd)


# --- the lines of a plan -----------------------------------------------------------------------

def lines_of(text, state=None):
    """``(number, line, plain)`` for each line of `text`; `plain` is False inside a code fence, for
    a quoted line and inside an HTML comment, none of which is the document's own statement. A line
    ends at ``\\n``, ``\\r\\n`` or a lone ``\\r``. A comment is one that starts a line; text before
    ``<!--`` on a line is read. When `state` is a dict, ``open`` is set if a fence is still open at
    the end and ``comment`` if a comment is."""
    fence, comment = None, False
    for number, line in enumerate(io.StringIO(text, newline=None), 1):
        line = line.rstrip("\n")
        match = _FENCE.match(line)
        opener = match and not (match.group(1)[0] == "`" and "`" in line[match.end():])
        closer = match and match.group(1)[0] == (fence or " ")[0] \
            and len(match.group(1)) >= len(fence or "") and not line[match.end():].strip()
        line = line[:_LINE]
        if fence is None:
            if opener and not comment:
                fence = match.group(1)
                yield number, line, False
                continue
        elif closer:
            fence = None
            yield number, line, False
            continue
        if fence is not None:
            yield number, line, False
            continue
        if comment:
            end = line.find("-->")
            if end < 0:
                yield number, line, False
                continue
            comment = False
            line = line[end + 3:]
            yield number, line, bool(line.strip()) and not _QUOTE.match(line)
            continue
        start = line.find("<!--")
        if start >= 0 and "-->" not in line[start + 4:]:
            comment = True
            if not line[:start].strip():
                yield number, line, False
                continue
        yield number, line, not _QUOTE.match(line)
    if state is not None:
        state["open"] = fence is not None
        state["comment"] = comment


# --- the rules ---------------------------------------------------------------------------------

def name_problem(name):
    """What is wrong with the file name of a plan, or None."""
    match = _NAME.match(name)
    if not match:
        return "a plan is named YYYY-MM-DD-<topic>.md in lowercase kebab-case"
    try:
        datetime.date(int(match.group(1)), int(match.group(2)), int(match.group(3)))
    except ValueError:
        return "the date in a plan's name is not a date"
    return None


def _number(label):
    """The order of a label: ``B-A`` follows ``B`` and comes before ``C``."""
    return tuple(sum((ord(c) - 64) * 26 ** i for i, c in enumerate(reversed(part)))
                 for part in label.split("-"))


def header_problems(name, real, lines):
    """Problems with the title and the header fields of one plan."""
    problems, found, title, first = [], {}, None, True
    for number, line, plain in itertools.islice(lines, MAX_HEADER + 1):
        if number > MAX_HEADER:
            break
        if plain and _TWO.match(line):
            break
        if not plain:
            continue
        if first and line.strip():
            first, title = False, bool(_TITLE.match(line))
        match = _FIELD.match(line)
        if match:
            found.setdefault(match.group(1), []).append(match.group(2).strip())
    if not title:
        problems.append("%s has no title (a first line `# <title>`)" % name)
    for field in ("Status", "Created", "Specs"):
        count = len(found.get(field, ()))
        if count == 0:
            problems.append("%s has no %s line near the top" % (name, field))
        elif count > 1:
            problems.append("%s has %d %s lines near the top; there is one" % (name, count, field))
    problems.extend(_status_problem(name, found.get("Status", [""])[0], "Status" in found))
    problems.extend(_created_problem(name, real, found.get("Created", [""])[0], "Created" in found))
    problems.extend(_candidate_problem(name, found.get("Candidate", [])))
    return problems


def _status_problem(name, value, present):
    if not present:
        return []
    for status in STATUSES:
        if value == status or (value.startswith(status) and value[len(status)] in " \t.,;:(—-"):
            return []
    return ["%s has the status %s; a plan is %s or %s"
            % (name, shown(value) or "(none)", ", ".join(STATUSES[:-1]), STATUSES[-1])]


def _created_problem(name, real, value, present):
    if not present:
        return []
    match = _DATE.match(value)
    try:
        if not match:
            raise ValueError
        datetime.date(int(match.group(1)), int(match.group(2)), int(match.group(3)))
    except ValueError:
        return ["%s has Created %s, which is not a date (YYYY-MM-DD)" % (name, shown(value))]
    if not real.startswith(value + "-"):
        return ["%s has Created %s, which differs from the date in its name" % (name, value)]
    return []


def _candidate_problem(name, values):
    if len(values) == 0:
        return ["%s has no Candidate line near the top (`Candidate: <roadmap>#<id>` or "
                "`Candidate: none` and a reason)" % name]
    if len(values) > 1:
        return ["%s has %d Candidate lines near the top; there is exactly one" % (name, len(values))]
    value = values[0]
    if _CANDIDATE.match(value):
        return []
    none = _NONE.match(value)
    if none:
        if any(c.isalnum() for c in none.group(1) or ""):
            return []
        return ["%s has `Candidate: none` with no reason" % name]
    return ["%s has the Candidate %s; it is <roadmap>#<id> or `none` and a reason"
            % (name, shown(value))]


def _section(text):
    """The words of a ``##`` heading, as the check compares them."""
    return " ".join(text.split()).rstrip("#").strip().rstrip(":.").strip().casefold()


def increment_problems(name, lines):
    """``(problems, warnings)`` for the increment headings of one plan. Only the headings under
    ``## Increments`` are increments; the same form elsewhere (a result note, say) is text."""
    problems, warnings, labels, last, count = [], [], set(), None, 0
    inside = has_section = False
    outside = 0
    for number, line, plain in lines:
        if not plain:
            continue
        line = line.rstrip()
        two = _TWO.match(line)
        if two and _NEAR.match(line):
            problems.append("%s line %d: the increment heading is not of the form "
                            "`### Increment <label> — <title>`" % (name, number))
            continue
        if two:
            inside = _section(two.group(1)) == "increments"
            has_section = has_section or inside
            continue
        match = _INCREMENT.match(line)
        if not inside:
            outside += bool(match)
            continue
        if not match:
            if _NEAR.match(line):
                problems.append("%s line %d: the increment heading is not of the form "
                                "`### Increment <label> — <title>`" % (name, number))
            continue
        count += 1
        if count > MAX_INCREMENTS:
            problems.append("%s has more than %d increments; the rest were not looked at"
                            % (name, MAX_INCREMENTS))
            break
        label = match.group(1)
        if label in labels:
            problems.append("%s line %d: the label %s repeats an earlier one" % (name, number, label))
        elif last is not None and _number(label) < _number(last):
            problems.append("%s line %d: the label %s comes after %s, which is later in order"
                            % (name, number, label, last))
        labels.add(label)
        if last is None or _number(label) > _number(last):
            last = label
    if not has_section:
        problems.append("%s has no `## Increments` section%s" % (
            name, ", so its %d increment heading%s were not checked" % (outside, "" if outside == 1
                                                                       else "s") if outside else ""))
    if count > LIMIT_INCREMENTS:
        problems.append("%s has %d increments; more than %d is two plans"
                        % (name, count, LIMIT_INCREMENTS))
    elif count > WARN_INCREMENTS:
        warnings.append("%s has %d increments; more than %d suggests two plans"
                        % (name, count, WARN_INCREMENTS))
    return problems, warnings


def plan_findings(name, real, data, size, limit):
    """``(problems, warnings)`` for one plan, given as the bytes read of a file of `size` bytes.
    `name` is how it is shown and `real` is the file's own name."""
    problems, warnings = [], []
    trouble = name_problem(real)
    if trouble:
        problems.append("%s: %s" % (name, trouble))
    if size > limit:
        problems.append("%s: larger than the %d bytes looked at; only the start was examined"
                        % (name, limit))
    text = data.decode("utf-8", "replace")
    closing = {}
    for _ in lines_of(text, closing):
        pass
    if closing["open"]:
        problems.append("%s: a code fence is never closed, so what follows it was not looked at"
                        % name)
    if closing["comment"]:
        problems.append("%s: an HTML comment is never closed, so what follows it was not looked at"
                        % name)
    problems.extend(header_problems(name, real, lines_of(text)))
    more, warn = increment_problems(name, lines_of(text))
    return problems + more, warnings + warn


# --- the plans of a project --------------------------------------------------------------------

def examine(root):
    """``(checked, problems, warnings)`` for the plans of the project at `root`."""
    problems, warnings, checked = [], [], 0
    budget = [MAX_FILES, MAX_BYTES]
    root_fd = os.open(root, _DIR)
    try:
        try:
            folder = open_dir(root_fd, PLANS)
        except OSError as exc:
            return 0, ["%s: cannot be listed: %s" % (PLANS, shown(exc.strerror or exc))], []
        if folder is None:
            return 0, [], []
        try:
            entries, cut = list_dir(folder)
            seen = {}
            for name, kind in entries:
                label = "%s/%s" % (PLANS, shown(name))
                folded = name.casefold()
                if kind == "dir" or not folded.endswith(".md") or folded == "readme.md":
                    continue
                try:
                    name.encode("utf-8")
                except UnicodeEncodeError:
                    problems.append("%s: the name is not usable" % label)
                    continue
                if folded in seen:
                    problems.append("%s: collides with %s, which differs only in letter case"
                                    % (label, shown(seen[folded])))
                seen[folded] = name
                if kind != "file":
                    problems.append("%s: is not a regular file, so it was not read" % label)
                    continue
                if budget[0] <= 0 or budget[1] <= 0:
                    problems.append("%s: not looked at; more than %d plans or %d bytes"
                                    % (label, MAX_FILES, MAX_BYTES))
                    continue
                budget[0] -= 1
                limit = min(MAX_DOCUMENT, budget[1])
                try:
                    data, size = read_file(folder, name, limit)
                except OSError as exc:
                    problems.append("%s: cannot be read: %s" % (label, shown(exc.strerror or exc)))
                    continue
                budget[1] -= size
                checked += 1
                more, warn = plan_findings(label, name, data, size, limit)
                problems.extend(more)
                warnings.extend(warn)
                if len(problems) > MAX_REPORTED:
                    problems.append("%s: stopped after %d problems; the plans after %s were not "
                                    "looked at" % (PLANS, MAX_REPORTED, shown(name)))
                    break
            if cut:
                problems.append("%s: more than %d entries; the rest were not listed"
                                % (PLANS, MAX_LISTED))
        finally:
            os.close(folder)
    finally:
        os.close(root_fd)
    return checked, problems, warnings


def command_check(root, out, err):
    checked, problems, warnings = examine(root)
    found = len(problems)
    if found > MAX_REPORTED + 1:
        # What was not looked at is never among the lines dropped.
        notices = [p for p in problems[MAX_REPORTED:] if "not looked at" in p or "not listed" in p]
        problems = problems[:MAX_REPORTED] + notices + ["more plan problems are not listed"]
    for line in problems:
        err.write("problem: %s\n" % line)
    for line in warnings[:MAX_REPORTED]:
        err.write("warning: %s\n" % line)
    if len(warnings) > MAX_REPORTED:
        err.write("warning: more plan warnings are not listed\n")
    out.write("checked %d plan%s\n" % (checked, "" if checked == 1 else "s"))
    if problems:
        out.write("check found %d problem%s\n" % (found, "" if found == 1 else "s"))
        return 1
    out.write("check found no problems\n")
    return 0


COMMANDS = {"check": command_check}


def main(argv, out, err, cwd):
    """Run one subcommand from `cwd`. Returns the exit code."""
    try:
        if len(argv) != 1 or argv[0] not in COMMANDS:
            raise Refused("usage: code-work %s (no arguments)" % "|".join(sorted(COMMANDS)))
        return COMMANDS[argv[0]](find_root(cwd), out, err)
    except Refused as exc:
        err.write("refused: %s\n" % exc)
        return 1
    except OSError as exc:
        err.write("failed: %s\n" % shown(exc.strerror or exc))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdout, sys.stderr, os.getcwd()))
