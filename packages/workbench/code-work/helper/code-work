#!/usr/bin/env python3
"""The code-work helper: reads a project's plans and says what is wrong with them.

It is one file that imports the standard library and the workbench kit (``wbkit``); the launcher runs a
private copy of it through the kit runner with nothing beside it. The three subcommands above the line
"running git" below change nothing, take no lock, run no program and follow no link. The code below that
line is what the subcommands that change a repository use; it starts one program, ``git``.

    code-work check      report problems with the plans in docs/plans/ (exit 1 if there is one)
    code-work plans      list the plans that are Proposed, Approved or In Progress
    code-work report     list the roadmap candidates a Completed plan names, and the plans whose
                         Candidate: names a roadmap or candidate that is not there
    code-work commit     make one local commit of exactly the named files (see `parse_commit`)

The rules are in ``docs/specs/code-work.md`` and in the README the module writes into
``docs/plans/``. Everything read is untrusted repository content: the number of files, the bytes in
all, the bytes of one plan and the findings reported are bounded, and passing a bound is itself a
problem that says what was not looked at. Nothing read is evaluated, and anything shown has its
escapes and non-ASCII characters written out.
"""

import datetime
import html
import io
import itertools
import json
import os
import re
import stat
import sys
import unicodedata

from wbkit import display, safefs

MAX_FILES = 2000
MAX_BYTES = 4 * 1024 * 1024
MAX_DOCUMENT = 1024 * 1024
MAX_LISTED = 20000
MAX_HEADER = 40
MAX_INCREMENTS = 1000
MAX_REPORTED = 200
MAX_CANDIDATES = 2000
MAX_DEPTH = 64
WARN_INCREMENTS = 15
LIMIT_INCREMENTS = 26

STATUSES = ("Proposed", "Approved", "In Progress", "Completed", "Superseded")
ACTIVE = STATUSES[:3]
PLANS = "docs/plans"
ROADMAPS = "docs/roadmaps"
MANIFEST = ".workbench/manifest.json"

_SLUG = r"[a-z0-9]+(?:-[a-z0-9]+)*"
_NAME = re.compile(r"\A([0-9]{4})-([0-9]{2})-([0-9]{2})-(%s)\.md\Z" % _SLUG)
_DATE = re.compile(r"\A([0-9]{4})-([0-9]{2})-([0-9]{2})\Z")
_ITEM = r"(?:(?:[-*+]|[0-9]{1,9}[.)])[ \t]+)?"
_FENCE = re.compile(r"\A[ ]{0,3}" + _ITEM + r"(`{3,}|~{3,})")
_QUOTE = re.compile(r"\A[ ]{0,3}>")
_TWO = re.compile(r"\A[ ]{0,3}##[ \t]+(.*)")
_TITLE = re.compile(r"\A[ ]{0,3}#[ \t]+\S")
_FIELD = re.compile(r"\A[ ]{0,3}(Status|Created|Candidate|Specs):[ \t]*(.*)\Z")
_CANDIDATE = re.compile(r"\A(%s)#(%s)\Z" % (_SLUG, _SLUG))
_NONE = re.compile(r"\Anone(?:\Z|[ \t,.;:(—-]+(.*))", re.S)
_LABEL = r"[A-Z]{1,3}(?:-[A-Z]{1,3})*"
_INCREMENT = re.compile(r"\A###[ ]Increment[ ](%s)[ ]—[ ]\S.*\Z" % _LABEL)
_NEAR = re.compile(r"\A[ ]{0,3}#{1,6}[ \t]+Increment\b", re.I)
_CANDIDATE_HEAD = re.compile(r"\A[ ]{0,3}" + _ITEM + r"###[ \t]+([^\s:]+)")
_UNDERLINE = re.compile(r"\A[ ]{0,3}(=+|-+)[ \t]*\Z")
_LINE = 2000
_HEADING = 200


class Refused(Exception):
    """Nothing was looked at; the message says why."""


def shown(text, limit=120):
    """`text` with every character outside printable ASCII written as an escape, cut to `limit`."""
    out = []
    for char in str(text)[:limit]:
        if " " <= char <= "~":
            out.append(char)
        elif ord(char) < 0x100:
            out.append("\\x%02x" % ord(char))
        elif ord(char) < 0x10000:
            out.append("\\u%04x" % ord(char))
        else:
            out.append("\\U%08x" % ord(char))
    return "".join(out)


# --- reading a project without following a link ------------------------------------------------

_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
_FILE = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)


def find_root(start):
    """The nearest directory at or above `start` that holds `.git` and a regular manifest."""
    here = start
    for _ in range(MAX_DEPTH):
        try:
            git = os.lstat(os.path.join(here, ".git"))
            if not stat.S_ISDIR(os.lstat(os.path.join(here, ".workbench")).st_mode):
                raise OSError("not a directory")
            manifest = os.lstat(os.path.join(here, *MANIFEST.split("/")))
        except OSError:
            git = manifest = None
        if git is not None and manifest is not None and stat.S_ISDIR(git.st_mode) \
                and stat.S_ISREG(manifest.st_mode):
            return here
        parent = os.path.dirname(here)
        if parent == here:
            break
        here = parent
    raise Refused("this is not inside a workbench project (no .git with %s above %s)"
                  % (MANIFEST, shown(start)))


def open_dir(root_fd, relative):
    """A descriptor for the directory `relative` below `root_fd`, or None when a part is absent.
    A link or a file on the way is an error."""
    fd = os.dup(root_fd)
    try:
        for part in relative.split("/"):
            try:
                step = os.open(part, _DIR, dir_fd=fd)
            except FileNotFoundError:
                return None
            os.close(fd)
            fd = step
        taken, fd = fd, -1
        return taken
    finally:
        if fd >= 0:
            os.close(fd)


def list_dir(fd):
    """``([(name, kind)], cut)``; `kind` is ``file``, ``dir`` or ``other``. At most MAX_LISTED."""
    found, cut = [], False
    with os.scandir(fd) as entries:
        for entry in entries:
            if len(found) >= MAX_LISTED:
                cut = True
                break
            try:
                mode = entry.stat(follow_symlinks=False).st_mode
            except OSError:
                found.append((entry.name, "other"))
                continue
            kind = "file" if stat.S_ISREG(mode) else "dir" if stat.S_ISDIR(mode) else "other"
            found.append((entry.name, kind))
    return sorted(found), cut


def read_file(dir_fd, name, limit):
    """``(bytes, size)``: at most `limit` bytes of the regular file `name`, and its size."""
    fd = os.open(name, _FILE, dir_fd=dir_fd)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError("not a regular file")
        chunks, taken = [], 0
        while taken < limit:
            piece = os.read(fd, min(65536, limit - taken))
            if not piece:
                break
            chunks.append(piece)
            taken += len(piece)
        return b"".join(chunks), info.st_size
    finally:
        os.close(fd)


# --- the lines of a plan -----------------------------------------------------------------------

def lines_of(text, state=None):
    """``(number, line, plain)`` for each line of `text`; `plain` is False inside a code fence, for
    a quoted line and inside an HTML comment, none of which is the document's own statement. A line
    ends at ``\\n``, ``\\r\\n`` or a lone ``\\r``. A comment is one that starts a line, and the whole of
    its last line is hidden; text before ``<!--`` on a line is read. When `state` is a dict, ``open`` is set if a fence is still open at
    the end and ``comment`` if a comment is."""
    fence, comment = None, False
    for number, line in enumerate(io.StringIO(text, newline=None), 1):
        line = line.rstrip("\n")
        match = _FENCE.match(line)
        opener = match and not (match.group(1)[0] == "`" and "`" in line[match.end():])
        closer = match and match.group(1)[0] == (fence or " ")[0] \
            and len(match.group(1)) >= len(fence or "") and not line[match.end():].strip()
        line = line[:_LINE]
        if fence is None:
            if opener and not comment:
                fence = match.group(1)
                yield number, line, False
                continue
        elif closer:
            fence = None
            yield number, line, False
            continue
        if fence is not None:
            yield number, line, False
            continue
        if comment:
            end = line.find("-->")
            if end < 0:
                yield number, line, False
                continue
            comment = False
            yield number, line, False
            continue
        start = line.find("<!--")
        if start >= 0 and not line[:start].strip():
            # An HTML block runs to the line that holds `-->`, all of it, so what follows the
            # closing marker on that line is not a heading or a field either.
            comment = "-->" not in line[start + 4:]
            yield number, line, False
            continue
        if start >= 0 and "-->" not in line[start + 4:]:
            comment = True
        yield number, line, not _QUOTE.match(line)
    if state is not None:
        state["open"] = fence is not None
        state["comment"] = comment


# --- the rules ---------------------------------------------------------------------------------

def name_problem(name):
    """What is wrong with the file name of a plan, or None."""
    match = _NAME.match(name)
    if not match:
        return "a plan is named YYYY-MM-DD-<topic>.md in lowercase kebab-case"
    try:
        datetime.date(int(match.group(1)), int(match.group(2)), int(match.group(3)))
    except ValueError:
        return "the date in a plan's name is not a date"
    return None


def _number(label):
    """The order of a label: ``B-A`` follows ``B`` and comes before ``C``."""
    return tuple(sum((ord(c) - 64) * 26 ** i for i, c in enumerate(reversed(part)))
                 for part in label.split("-"))


def header_fields(lines):
    """``(fields, title)``: the values of each ``Status``, ``Created``, ``Candidate`` and ``Specs``
    line in the header, and whether the first line is a title."""
    found, title, first = {}, None, True
    for number, line, plain in itertools.islice(lines, MAX_HEADER + 1):
        if number > MAX_HEADER:
            break
        if plain and _TWO.match(line):
            break
        if not plain:
            continue
        if first and line.strip():
            first, title = False, bool(_TITLE.match(line))
        match = _FIELD.match(line)
        if match:
            found.setdefault(match.group(1), []).append(match.group(2).strip())
    return found, title


def header_problems(name, real, lines):
    """Problems with the title and the header fields of one plan."""
    problems = []
    found, title = header_fields(lines)
    if not title:
        problems.append("%s has no title (a first line `# <title>`)" % name)
    for field in ("Status", "Created", "Specs"):
        count = len(found.get(field, ()))
        if count == 0:
            problems.append("%s has no %s line near the top" % (name, field))
        elif count > 1:
            problems.append("%s has %d %s lines near the top; there is one" % (name, count, field))
    problems.extend(_status_problem(name, found.get("Status", [""])[0], "Status" in found))
    problems.extend(_created_problem(name, real, found.get("Created", [""])[0], "Created" in found))
    problems.extend(_candidate_problem(name, found.get("Candidate", [])))
    return problems


def status_of(value):
    """The status a `Status:` value begins with, or None."""
    for status in STATUSES:
        if value == status or (value.startswith(status) and value[len(status)] in " \t.,;:(—-"):
            return status
    return None


def _status_problem(name, value, present):
    if not present:
        return []
    if status_of(value):
        return []
    return ["%s has the status %s; a plan is %s or %s"
            % (name, shown(value) or "(none)", ", ".join(STATUSES[:-1]), STATUSES[-1])]


def _created_problem(name, real, value, present):
    if not present:
        return []
    match = _DATE.match(value)
    try:
        if not match:
            raise ValueError
        datetime.date(int(match.group(1)), int(match.group(2)), int(match.group(3)))
    except ValueError:
        return ["%s has Created %s, which is not a date (YYYY-MM-DD)" % (name, shown(value))]
    if not real.startswith(value + "-"):
        return ["%s has Created %s, which differs from the date in its name" % (name, value)]
    return []


def _candidate_problem(name, values):
    if len(values) == 0:
        return ["%s has no Candidate line near the top (`Candidate: <roadmap>#<id>` or "
                "`Candidate: none` and a reason)" % name]
    if len(values) > 1:
        return ["%s has %d Candidate lines near the top; there is exactly one" % (name, len(values))]
    value = values[0]
    if _CANDIDATE.match(value):
        return []
    none = _NONE.match(value)
    if none:
        if any(c.isalnum() for c in none.group(1) or ""):
            return []
        return ["%s has `Candidate: none` with no reason" % name]
    return ["%s has the Candidate %s; it is <roadmap>#<id> or `none` and a reason"
            % (name, shown(value))]


def _section(text):
    """The words of a ``##`` heading, as the check compares them."""
    return " ".join(text.split()).rstrip("#").strip().rstrip(":.").strip().casefold()


def increment_problems(name, lines):
    """``(problems, warnings)`` for the increment headings of one plan. Only the headings under
    ``## Increments`` are increments; the same form elsewhere (a result note, say) is text."""
    problems, warnings, labels, last, count = [], [], set(), None, 0
    inside = has_section = False
    outside = 0
    for number, line, plain in lines:
        if not plain:
            continue
        line = line.rstrip()
        two = _TWO.match(line)
        if two and _NEAR.match(line):
            problems.append("%s line %d: the increment heading is not of the form "
                            "`### Increment <label> — <title>`" % (name, number))
            continue
        if two:
            inside = _section(two.group(1)) == "increments"
            has_section = has_section or inside
            continue
        match = _INCREMENT.match(line)
        if not inside:
            outside += bool(match)
            continue
        if not match:
            if _NEAR.match(line):
                problems.append("%s line %d: the increment heading is not of the form "
                                "`### Increment <label> — <title>`" % (name, number))
            continue
        count += 1
        if count > MAX_INCREMENTS:
            problems.append("%s has more than %d increments; the rest were not looked at"
                            % (name, MAX_INCREMENTS))
            break
        label = match.group(1)
        if label in labels:
            problems.append("%s line %d: the label %s repeats an earlier one" % (name, number, label))
        elif last is not None and _number(label) < _number(last):
            problems.append("%s line %d: the label %s comes after %s, which is later in order"
                            % (name, number, label, last))
        labels.add(label)
        if last is None or _number(label) > _number(last):
            last = label
    if not has_section:
        problems.append("%s has no `## Increments` section%s" % (
            name, ", so its %d increment heading%s were not checked" % (outside, "" if outside == 1
                                                                       else "s") if outside else ""))
    if count > LIMIT_INCREMENTS:
        problems.append("%s has %d increments; more than %d is two plans"
                        % (name, count, LIMIT_INCREMENTS))
    elif count > WARN_INCREMENTS:
        warnings.append("%s has %d increments; more than %d suggests two plans"
                        % (name, count, WARN_INCREMENTS))
    return problems, warnings


def plan_findings(name, real, data):
    """``(problems, warnings)`` for one plan, given as the bytes read of it. `name` is how it is
    shown and `real` is the file's own name."""
    problems, warnings = [], []
    trouble = name_problem(real)
    if trouble:
        problems.append("%s: %s" % (name, trouble))
    text = data.decode("utf-8", "replace")
    closing = {}
    for _ in lines_of(text, closing):
        pass
    if closing["open"]:
        problems.append("%s: a code fence is never closed, so what follows it was not looked at"
                        % name)
    if closing["comment"]:
        problems.append("%s: an HTML comment is never closed, so what follows it was not looked at"
                        % name)
    problems.extend(header_problems(name, real, lines_of(text)))
    more, warn = increment_problems(name, lines_of(text))
    return problems + more, warnings + warn


# --- the documents of a project ----------------------------------------------------------------

def collect(root_fd, folder, budget, problems):
    """``[(label, name, data, size, limit)]`` for the regular ``.md`` files of `folder`, in name
    order, or None when the folder is not there or cannot be listed. What could not be read, and why, is added to
    `problems`. `budget` is ``[files, bytes]`` left and is spent as files are read."""
    try:
        handle = open_dir(root_fd, folder)
    except OSError as exc:
        problems.append("%s: cannot be listed: %s" % (folder, shown(exc.strerror or exc)))
        return None
    if handle is None:
        return None
    found, seen = [], {}
    try:
        entries, cut = list_dir(handle)
        for name, kind in entries:
            label = "%s/%s" % (folder, shown(name))
            folded = name.casefold()
            if kind == "dir" or not folded.endswith(".md") or folded == "readme.md":
                continue
            try:
                name.encode("utf-8")
            except UnicodeEncodeError:
                problems.append("%s: the name is not usable" % label)
                continue
            if folded in seen:
                problems.append("%s: collides with %s, which differs only in letter case"
                                % (label, shown(seen[folded])))
            seen[folded] = name
            if kind != "file":
                problems.append("%s: is not a regular file, so it was not read" % label)
                continue
            if budget[0] <= 0 or budget[1] <= 0:
                problems.append("%s: not looked at; more than %d files or %d bytes"
                                % (label, MAX_FILES, MAX_BYTES))
                continue
            budget[0] -= 1
            limit = min(MAX_DOCUMENT, budget[1])
            try:
                data, size = read_file(handle, name, limit)
            except OSError as exc:
                problems.append("%s: cannot be read: %s" % (label, shown(exc.strerror or exc)))
                continue
            budget[1] -= size
            if size > limit:
                problems.append("%s: larger than the %d bytes looked at; only the start was "
                                "examined" % (label, limit))
            found.append((label, name, data, size, limit))
        if cut:
            problems.append("%s: more than %d entries; the rest were not listed"
                            % (folder, MAX_LISTED))
    finally:
        os.close(handle)
    return found


def examine(root):
    """``(checked, problems, warnings)`` for the plans of the project at `root`."""
    problems, warnings, checked = [], [], 0
    root_fd = os.open(root, _DIR)
    try:
        items = collect(root_fd, PLANS, [MAX_FILES, MAX_BYTES], problems) or []
    finally:
        os.close(root_fd)
    for label, name, data, size, limit in items:
        checked += 1
        more, warn = plan_findings(label, name, data)
        problems.extend(more)
        warnings.extend(warn)
        if len(problems) > MAX_REPORTED:
            problems.append("%s: stopped after %d problems; the plans after %s were not looked at"
                            % (PLANS, MAX_REPORTED, shown(name)))
            break
    return checked, problems, warnings


def plan_facts(data, state=None):
    """``(status, candidate)`` a plan's header states: the first `Status:` line's status, and the
    `Candidate:` line's ``<roadmap>#<id>`` when there is exactly one and it has that form. `state` is
    passed to `lines_of`."""
    found, _ = header_fields(lines_of(data.decode("utf-8", "replace"), state))
    status = status_of(found["Status"][0]) if found.get("Status") else None
    values = found.get("Candidate", [])
    candidate = values[0] if len(values) == 1 and _CANDIDATE.match(values[0]) else None
    return status, candidate


def _heading(text):
    """A ``##`` heading's words as a reader sees them, as ``doccheck`` reads them: entities
    decoded, no emphasis marks, comment, closing hashes or trailing colon or full stop."""
    text = " ".join(html.unescape(" ".join(text.split())[:_HEADING * 4]).split())[:_HEADING]
    for mark in "*_`\\":
        text = text.replace(mark, "")
    while True:
        start = text.find("<!--")
        if start < 0:
            break
        end = text.find("-->", start + 4)
        text = text[:start] + (text[end + 3:] if end >= 0 else "")
    text = text.strip()
    bare = text.rstrip("#")
    if bare != text and (not bare or bare[-1] in " \t"):
        text = bare
    return text.strip().rstrip(":.").strip().casefold()


def roadmap_candidates(text, state=None):
    """``([(id, line)], cut)``: the ``###`` headings under ``## Candidates`` of a roadmap, as
    ``doccheck`` reads them (a setext heading too), and whether the list was cut at MAX_CANDIDATES.
    `state` is passed to `lines_of`."""
    inside, cut, found, before = False, False, [], None
    for number, line, plain in lines_of(text, state):
        if not plain:
            before = None
            continue
        under = _UNDERLINE.match(line)
        if under and before is not None:
            inside = under.group(1)[0] == "-" and _heading(before) == "candidates"
            before = None
            continue
        two = _TWO.match(line)
        if two:
            inside = _heading(two.group(1)) == "candidates"
            before = None
            continue
        stripped = line.strip()
        before = stripped if stripped and not stripped.startswith(("#", ">")) else None
        match = _CANDIDATE_HEAD.match(line) if inside else None
        if match:
            if len(found) >= MAX_CANDIDATES:
                cut = True
            else:
                found.append((match.group(1), number))
    return found, cut


def _roadmap_ids(items, problems):
    """``{roadmap: set of candidate ids}`` for the roadmaps read."""
    known = {}
    for label, name, data, size, limit in items:
        stem = name[:-3]
        if not re.fullmatch(_SLUG, stem):
            continue
        closing = {}
        found, cut = roadmap_candidates(data.decode("utf-8", "replace"), closing)
        if closing["open"] or closing["comment"]:
            problems.append("%s: a code fence or an HTML comment is never closed, so what follows "
                            "it was not looked at" % label)
        if cut:
            problems.append("%s: more than %d candidates; the rest were not looked at"
                            % (label, MAX_CANDIDATES))
        known[stem] = {each for each, _ in found}
    return known


def command_check(root, out, err):
    checked, problems, warnings = examine(root)
    found = len(problems)
    if found > MAX_REPORTED + 1:
        # What was not looked at is never among the lines dropped.
        notices = [p for p in problems[MAX_REPORTED:] if "not looked at" in p or "not listed" in p]
        problems = problems[:MAX_REPORTED] + notices + ["more plan problems are not listed"]
    for line in problems:
        err.write("problem: %s\n" % line)
    for line in warnings[:MAX_REPORTED]:
        err.write("warning: %s\n" % line)
    if len(warnings) > MAX_REPORTED:
        err.write("warning: more plan warnings are not listed\n")
    out.write("checked %d plan%s\n" % (checked, "" if checked == 1 else "s"))
    if problems:
        out.write("check found %d problem%s\n" % (found, "" if found == 1 else "s"))
        return 1
    out.write("check found no problems\n")
    return 0


def _read_plans(root):
    """``(items, problems)``: the plans of the project at `root` and what could not be read."""
    problems = []
    root_fd = os.open(root, _DIR)
    try:
        return collect(root_fd, PLANS, [MAX_FILES, MAX_BYTES], problems) or [], problems
    finally:
        os.close(root_fd)


def _finish(problems, out, err):
    for line in problems[:MAX_REPORTED]:
        err.write("problem: %s\n" % line)
    if len(problems) > MAX_REPORTED:
        err.write("problem: more problems are not listed\n")
    return 1 if problems else 0


def _unread(label, status, closing, problems):
    """Say so when a plan has no status because a fence or comment was never closed."""
    if status is None and (closing.get("open") or closing.get("comment")):
        problems.append("%s: a code fence or an HTML comment is never closed, so its status was "
                        "not looked for" % label)


def command_plans(root, out, err):
    items, problems = _read_plans(root)
    for label, name, data, size, limit in items:
        closing = {}
        status, _ = plan_facts(data, closing)
        _unread(label, status, closing, problems)
        if status in ACTIVE:
            out.write("%s: %s\n" % (shown(name), status))
    return _finish(problems, out, err)


def command_report(root, out, err):
    problems, budget = [], [MAX_FILES, MAX_BYTES]
    root_fd = os.open(root, _DIR)
    try:
        roadmaps = collect(root_fd, ROADMAPS, budget, problems)
        # A roadmap that was not read in full cannot be said to lack a candidate.
        unsure = bool(problems)
        plans = collect(root_fd, PLANS, budget, problems) if roadmaps is not None else None
    finally:
        os.close(root_fd)
    if roadmaps is not None:
        before = len(problems)
        known = _roadmap_ids(roadmaps, problems)
        unsure = unsure or len(problems) > before
        complete, lost = set(), []
        for label, name, data, size, limit in plans or ():
            closing = {}
            status, candidate = plan_facts(data, closing)
            _unread(label, status, closing, problems)
            if candidate is None:
                continue
            roadmap, _, each = candidate.partition("#")
            if unsure:
                if roadmap in known and each in known[roadmap] and status == "Completed":
                    complete.add(candidate)
            elif roadmap not in known:
                lost.append("unresolved %s names %s: no such roadmap" % (shown(name), shown(candidate)))
            elif each not in known[roadmap]:
                lost.append("unresolved %s names %s: no such candidate" % (shown(name), shown(candidate)))
            elif status == "Completed":
                complete.add(candidate)
        for each in sorted(complete):
            out.write("complete %s\n" % shown(each))
        for line in lost:
            out.write(line + "\n")
    return _finish(problems, out, err)


# --- running git ---------------------------------------------------------------------------------
# Everything above this line is the read-only part of the helper: it opens nothing for writing and runs
# no program. The code below is what the subcommands that change a repository use. It starts one
# program, `git`, found on a PATH entry outside the repository, with an environment built here, and
# only in one of the shapes listed in `git_shape_ok`. The repository is untrusted: its configuration and
# hooks are read for the names of anything that would make git run a program, and a commit is refused
# when there is one. The owner's own global and system Git configuration is trusted.

FALLBACK_PATH = ["/usr/bin", "/bin"]
GIT_TIMEOUT = 120
MAX_REF = 200
MAX_GITLINK_FINDINGS = 5
_KEPT = ("HOME", "XDG_CONFIG_HOME", "USER", "LOGNAME", "LANG", "TZ", "TERM", "TMPDIR")
_BRANCH = re.compile(r"\Arefs/heads/[A-Za-z0-9._][A-Za-z0-9._/-]*\Z")
_DIFF_FLAGS = ("--cached", "--name-only", "-z", "--check", "--no-ext-diff", "--no-textconv", "--no-renames")
# Repository settings shaped like "a program or command to run": the shape decides and not a list of
# names, because a list kept missing keys. A key is lower-cased before it is matched.
EXEC_KEY = re.compile(
    r".*\.(program|command|driver|cmd|clean|smudge|process|textconv|external|defaultkeycommand)"
    r"|core\.(hookspath|fsmonitor|sshcommand)")


def is_inside(path, boundary):
    """True when `path` is `boundary` or below it, whatever links and case spellings lead there."""
    try:
        current = os.path.realpath(path)
        while True:
            if os.path.samefile(current, boundary):
                return True
            parent = os.path.dirname(current)
            if parent == current:
                return False
            current = parent
    except OSError:
        return False


def repository_boundary(start):
    """The nearest ancestor of `start` that holds a `.git` entry, found without running git."""
    current = os.path.realpath(start)
    while True:
        if os.path.lexists(os.path.join(current, ".git")):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return os.path.realpath(start)
        current = parent


def outermost_boundary(start):
    """The outermost ancestor of `start` that holds a `.git` entry. A PATH entry is trusted only when it is
    outside this one, so a repository embedded in another cannot make the outer one look outside."""
    current = os.path.realpath(start)
    found = None
    while True:
        if os.path.lexists(os.path.join(current, ".git")):
            found = current
        parent = os.path.dirname(current)
        if parent == current:
            return found or os.path.realpath(start)
        current = parent


def trusted_path_entries(boundary):
    """The PATH entries that are absolute and outside the repository: never "", "." or a relative one."""
    return [entry for entry in os.environ.get("PATH", "").split(os.pathsep)
            if entry and os.path.isabs(entry) and not is_inside(entry, boundary)]


def trusted_which(name, boundary, entries=None):
    """The first executable `name` in a trusted entry that does not resolve into the repository."""
    for entry in trusted_path_entries(boundary) if entries is None else entries:
        candidate = os.path.join(entry, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) \
                and not is_inside(candidate, boundary):
            return candidate
    return None


def git_environment(entries, extra=None):
    """The environment git runs in: a short list of the caller's variables, the trusted PATH and the
    few Git variables set here. No variable of the caller that starts with GIT_ is passed."""
    env = {name: os.environ[name] for name in _KEPT if name in os.environ}
    env.update({name: value for name, value in os.environ.items() if name.startswith("LC_")})
    env["PATH"] = os.pathsep.join(entries)
    env.update({"GIT_NO_REPLACE_OBJECTS": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_EDITOR": "true",
                "GIT_PAGER": "cat", "GIT_LITERAL_PATHSPECS": "1"})
    env.update(extra or {})
    return env


def _branch_ref(ref):
    return (isinstance(ref, str) and len(ref) <= MAX_REF + 11 and _BRANCH.match(ref) is not None
            and ".." not in ref and "//" not in ref and not ref.endswith(("/", ".lock", ".")))


def _paths_ok(paths):
    """True for one or more repository-relative paths: none empty, absolute or naming a `..` component, so
    a path cannot leave the repository (git treats two paths outside the work tree as ``--no-index``)."""
    return bool(paths) and all(item and not item.startswith("/") and ".." not in item.split("/")
                               for item in paths)


def _after_dashes(rest, start):
    """True when `rest` has `--` at `start` and, after it, one or more paths that stay in the repository."""
    return rest[start:start + 1] == ["--"] and _paths_ok(rest[start + 1:])


def _diff_shape(rest):
    flags = []
    for index, item in enumerate(rest):
        if item == "--":
            return len(set(flags)) == len(flags) and _after_dashes(rest, index)
        if item not in _DIFF_FLAGS:
            return False
        flags.append(item)
    return len(set(flags)) == len(flags) and bool(flags)


def _commit_shape(rest):
    start = 1 if rest[:1] == ["--cleanup=whitespace"] else 0
    index = start
    while rest[index:index + 1] == ["-m"] and index + 1 < len(rest):
        index += 2
    if index == start:
        return False
    tail = rest[index:]
    return tail == [] or (tail[:2] == ["--only", "--"] and _paths_ok(tail[2:]))


_SHAPES = {
    "rev-parse": lambda rest: rest in (["--show-toplevel"], ["--absolute-git-dir"], ["--git-common-dir"],
                                       ["HEAD"], ["--verify", "HEAD"], ["HEAD^@"])
    or (len(rest) == 3 and rest[:2] == ["--verify", "-q"] and _branch_ref(rest[2])),
    "diff": _diff_shape,
    "ls-files": lambda rest: (rest[:2] == ["--error-unmatch", "--"] and _paths_ok(rest[2:]))
    or rest == ["-s", "-z"] or (rest[:3] == ["-s", "-z", "--"] and _paths_ok(rest[3:])),
    "add": lambda rest: _after_dashes(rest, 0),
    "commit": _commit_shape,
    "reset": lambda rest: rest[:1] == ["-q"] and _after_dashes(rest, 1),
    "show": lambda rest: rest in (["-s", "--format=%s", "HEAD"], ["-s", "--format=%B", "HEAD"]),
    "diff-tree": lambda rest: rest in (
        ["--no-commit-id", "--name-only", "-r", "-z", "HEAD"],
        ["--root", "--no-commit-id", "--name-only", "-r", "-z", "HEAD"]),
    "config": lambda rest: rest == ["--list", "-z"],
    "status": lambda rest: rest == ["--porcelain=v1", "-z", "--untracked-files=all"],
}


def git_shape_ok(argv):
    """Whether `argv` is `git` and one of the few commands in the shapes this helper runs. Anything
    else, a global option before the subcommand included, is not run."""
    if not isinstance(argv, list) or len(argv) < 2 or argv[0] != "git" \
            or not all(type(item) is str and "\0" not in item for item in argv):
        return False
    shape = _SHAPES.get(argv[1])
    return shape is not None and bool(shape(argv[2:]))


def run(argv, cwd, check=True, timeout=GIT_TIMEOUT, env_extra=None):
    """Run `argv` (``git`` and a command in an allowed shape) in `cwd`; return the finished process.
    Raises ``Refused`` for a shape that is not allowed, a missing git, a timeout, or (with `check`) a
    nonzero exit."""
    import subprocess   # the one program this helper starts; imported here, below the read-only part
    if not git_shape_ok(argv):
        raise Refused("this helper does not run that git command: %s"
                      % display.ascii_text(" ".join(str(item)[:60] for item in argv[:3]))[:200])
    boundary = outermost_boundary(cwd)
    entries = trusted_path_entries(boundary) or FALLBACK_PATH
    found = trusted_which("git", boundary, entries)
    if found is None:
        raise Refused("git was not found in an absolute PATH entry outside the repository")
    try:
        result = subprocess.run([found] + argv[1:], cwd=cwd, capture_output=True, text=True,
                                encoding="utf-8", errors="surrogateescape", check=False,
                                env=git_environment(entries, env_extra), timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Refused("git %s did not finish within %d seconds" % (argv[1], timeout))
    except OSError as exc:
        raise Refused("git %s could not be started (%s)" % (argv[1], display.ascii_text(exc.strerror or "error")))
    if check and result.returncode:
        detail = (result.stderr or result.stdout or "no message").strip()[-300:]
        raise Refused("git %s failed (%d): %s" % (argv[1], result.returncode, display.ascii_text(detail)))
    return result


def git_root(path):
    """The root of the repository that holds `path`, after refusing a work tree or git directory that is
    not the repository's own `.git`: a `core.worktree` redirect, an embedded or separate repository, and a
    `.git` that is a link."""
    path = os.path.realpath(path)
    top = os.path.realpath(run(["git", "rev-parse", "--show-toplevel"], path).stdout.strip())
    holder = repository_boundary(path)
    try:
        same = os.path.samefile(top, holder)
    except OSError:
        same = False
    if not same:
        raise Refused("git reports a work tree that is not the repository holding its metadata "
                      "(a core.worktree redirect?); refusing to act")
    marker = os.path.join(top, ".git")
    if os.path.islink(marker):
        raise Refused("the repository's .git is a link; refusing to act")
    if os.path.isdir(marker):
        gitdir = run(["git", "rev-parse", "--absolute-git-dir"], path).stdout.strip()
        if os.path.realpath(gitdir) != os.path.realpath(marker):
            raise Refused("git is using a git directory that is not the repository's own .git "
                          "(an embedded or bare repository?); refusing to act")
    else:
        raise Refused("the repository's .git is not a directory (a separate git directory or a work tree "
                      "of another repository?); refusing to act")
    if os.path.commonpath([path, top]) != top:
        raise Refused("the working directory is outside the repository root git reports; refusing to act")
    return top


def head(root):
    return run(["git", "rev-parse", "HEAD"], root).stdout.strip()


def names(root, cached=False):
    """The paths git reports as changed in the work tree, or (with `cached`) staged."""
    command = ["git", "diff"] + (["--cached"] if cached else []) + ["--no-renames", "--name-only", "-z"]
    return {item for item in run(command, root).stdout.split("\0") if item}


def git_bool_is_true(has_value, value):
    """A Git boolean as Git reads it: a key with no value is true, an integer is true unless zero, and
    only the empty string, false, no, off and 0 are false. Anything unrecognised is true, the cautious
    reading."""
    if not has_value:
        return True
    text = value.strip().lower()
    if text in ("", "false", "no", "off"):
        return False
    try:
        return int(text, 0) != 0
    except ValueError:
        return True


def repo_program_findings(root):
    """The names, never the values, of repository settings and hooks that make a commit run a program."""
    findings = []
    quiet = {"GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1"}
    listing = run(["git", "config", "--list", "-z"], root, check=False, env_extra=quiet)
    if listing.returncode:
        return ["config:unreadable"]
    for entry in listing.stdout.split("\0"):
        key, separator, value = entry.partition("\n")
        lowered = key.lower()
        if EXEC_KEY.fullmatch(lowered) or (lowered == "commit.gpgsign"
                                           and git_bool_is_true(bool(separator), value)):
            findings.append(display.ascii_text(key)[:80])
    for flag in ("--absolute-git-dir", "--git-common-dir"):
        directory = run(["git", "rev-parse", flag], root).stdout.strip()
        hooks = os.path.join(directory if os.path.isabs(directory) else os.path.join(root, directory), "hooks")
        try:
            listed = sorted(os.listdir(hooks))
        except OSError:
            continue
        for name in listed:
            path = os.path.join(hooks, name)
            if not name.endswith(".sample") and os.path.isfile(path) and os.access(path, os.X_OK):
                findings.append("hook:" + display.ascii_text(name)[:60])
    listing = run(["git", "ls-files", "-s", "-z"], root, check=False)
    if listing.returncode:
        findings.append("index:unreadable")
    else:
        # A committed gitlink is a nested repository: git starts a child in it for `diff`, `status` and
        # `commit`, and that child reads the nested repository's own configuration, which is not read above.
        links = [entry.partition("\t")[2] for entry in listing.stdout.split("\0")
                 if entry.startswith("160000 ")]
        findings.extend("submodule:" + display.ascii_text(path)[:60] for path in links[:MAX_GITLINK_FINDINGS])
    return sorted(set(findings))


# --- commit --------------------------------------------------------------------------------------

MAX_SUBJECT = 300
MAX_BODY = 100000
MAX_TRAILERS = 50
MAX_TRAILER = 1000
MAX_PATHS = 2000
_HEX40 = re.compile(r"\A[0-9a-f]{40}\Z")
_TRAILER = re.compile(r"\A[A-Za-z][A-Za-z0-9-]{0,63}:[ ]+\S[^\0\r\n]*\Z")
_TOOL = r"(?:the\s+|an?\s+)?(?:ai\s+)?[\W_]{0,4}(claude|anthropic)\b"
_ATTRIBUTION = [re.compile(pattern, re.I) for pattern in (
    r"co[-\s]?(authored|developed)[-\s]?by\s*:[^\n]{0,200}(claude|anthropic)",
    r"signed[-\s]?off[-\s]?by\s*:[^\n]{0,200}(claude|anthropic)",
    r"\b(claude|anthropic)\b[^\n]{0,20}\b(wrote|authored|generated|created|made|drafted)\b",
    r"\b(assisted|generated|created|written|authored|reviewed|helped|made|drafted|powered|built|developed)[-\s]+"
    r"(with|by|using|via)\s+" + _TOOL,
    r"(assisted|generated|created|written|authored|reviewed|helped)[-\s]?(with|by)\s*:[^\n]{0,200}(claude|anthropic)",
    r"\bai[-\s]assisted\b[^\n]{0,20}\b(claude|anthropic)\b",
    r"noreply[^@\s]{0,20}@anthropic\.com",
    r"claude[-\s]session\s*:",
    r"(?<![A-Za-z0-9-])(?:www\.)?claude\.(ai|com)[:/?]\S")]
_CONFUSABLE = {0x430: "a", 0x435: "e", 0x43E: "o", 0x440: "p", 0x441: "c", 0x445: "x", 0x443: "y",
               0x455: "s", 0x456: "i", 0x458: "j", 0x3BF: "o", 0x3B1: "a", 0x501: "d", 0x57D: "u", 0x3C5: "u", 0x3BC: "u",
               0x251: "a", 0x1D04: "c", 0x142: "l", 0x19A: "l", 0x3002: "."}
_FILLERS = "\u115f\u1160\u3164\uffa0"
_BLANKS = "\u2800\u1680"
_LOOKALIKE_SCRIPTS = {"CYRILLIC", "GREEK", "ARMENIAN", "COPTIC", "CHEROKEE"}


def _script(char):
    """The script of a letter, from the first word of its Unicode name; the Japanese and Korean scripts
    and Han count as one, so a sentence that mixes them is not a mix."""
    first = unicodedata.name(char, "?").split(" ")[0]
    return "CJK" if first in ("CJK", "HIRAGANA", "KATAKANA", "HANGUL", "BOPOMOFO") else first
_COMMIT_OPTIONS = ("--expected-head", "--subject", "--body", "--trailer", "--leave-other-staged")


class Request:
    """What `commit` was asked to do, after the arguments were read."""

    def __init__(self):
        self.expected = None
        self.subject = None
        self.body = None
        self.trailers = []
        self.leave_other_staged = False
        self.paths = []


def parse_commit(argv):
    """Read the arguments of `commit` by hand: options, then ``--``, then the paths. An unknown option, a
    repeated one that takes one value, a missing value and a missing ``--`` are refused."""
    request = Request()
    seen = set()
    index = 0
    while index < len(argv) and argv[index] != "--":
        option = argv[index]
        if option not in _COMMIT_OPTIONS:
            raise Refused("unknown option: %s" % shown(option, 40))
        if option != "--trailer" and option in seen:
            raise Refused("%s was given more than once" % option)
        seen.add(option)
        if option == "--leave-other-staged":
            request.leave_other_staged = True
            index += 1
            continue
        if index + 1 >= len(argv):
            raise Refused("%s needs a value" % option)
        value = argv[index + 1]
        index += 2
        if option == "--expected-head":
            request.expected = value
        elif option == "--subject":
            request.subject = value
        elif option == "--body":
            request.body = value
        else:
            request.trailers.append(value)
    if index >= len(argv):
        raise Refused("usage: code-work commit --expected-head <hash> --subject <text> [--body <text>] "
                      "[--trailer 'Key: value']... [--leave-other-staged] -- <path>...")
    request.paths = argv[index + 1:]
    for required, label in ((request.expected, "--expected-head"), (request.subject, "--subject")):
        if required is None:
            raise Refused("%s is required" % label)
    if not request.paths:
        raise Refused("name at least one path after --")
    if len(request.paths) > MAX_PATHS:
        raise Refused("more than %d paths" % MAX_PATHS)
    return request


def validate_expected(value):
    if _HEX40.match(value) is None:
        raise Refused("--expected-head must be the full 40-digit lower-case hash of HEAD")


def validate_message(request):
    """Refuse a subject, body or trailer that git or a reader would read differently from what was given."""
    subject = request.subject
    if not subject.strip() or len(subject) > MAX_SUBJECT or any(c in subject for c in "\0\r\n"):
        raise Refused("the subject must be one non-empty line of at most %d characters" % MAX_SUBJECT)
    if request.body is not None:
        if "\0" in request.body or len(request.body) > MAX_BODY or not request.body.strip():
            raise Refused("the body must be non-empty text without NUL, at most %d characters" % MAX_BODY)
    if len(request.trailers) > MAX_TRAILERS:
        raise Refused("more than %d trailers" % MAX_TRAILERS)
    for trailer in request.trailers:
        if len(trailer) > MAX_TRAILER or _TRAILER.match(trailer) is None:
            raise Refused("a trailer must be one 'Key: value' line: %s" % shown(trailer, 60))


def _folded(text):
    """`text` as the attribution patterns read it: compatibility-normalised, without format characters and
    fillers, every dash a hyphen, every run of blanks one space, accents dropped, lower-cased, look-alike
    letters mapped to ASCII, a folded line joined to the one before. A combining mark that no precomposed
    letter holds, or a word that mixes scripts, cannot be read safely and is refused."""
    text = unicodedata.normalize("NFKC", text)
    if any(unicodedata.category(c) in ("Mn", "Me", "Co", "Cn") or c in _BLANKS
           or (unicodedata.category(c) == "Cc" and c not in "\n\t") for c in text):
        raise Refused("the message has a control, combining, private-use or invisible character; "
                      "write it with plain letters")
    text = "".join(c for c in text if unicodedata.category(c) != "Cf" and c not in _FILLERS)
    text = text.casefold()
    for word in re.findall(r"\w+", text.replace("\u03bc", "u")):      # a micro sign is not a look-alike
        scripts = {_script(c) for c in word if c.isalpha()}
        if "LATIN" in scripts and scripts & _LOOKALIKE_SCRIPTS:
            raise Refused("a word in the message mixes scripts: %s" % shown(word, 40))
    text = text.translate(_CONFUSABLE)
    text = "".join("-" if unicodedata.category(c) == "Pd" or c == "\u2212" else c for c in text)
    text = "".join(c for c in unicodedata.normalize("NFKD", text) if unicodedata.category(c) != "Mn")
    text = re.sub(r"[^\S\n]+", " ", text)
    return re.sub(r":[ \t]*\n[ \t]*", ": ", re.sub(r"\n[ \t]+", " ", text))


def refuse_attribution(request):
    """Refuse a message that names a tool as its author (the commit helper writes the owner's, not a tool's)."""
    fields = [request.subject] + ([request.body] if request.body is not None else []) + request.trailers
    for text in fields + ["\n".join(fields)]:
        folded = _folded(text)
        if any(pattern.search(folded) for pattern in _ATTRIBUTION):
            raise Refused("the message carries tool attribution; this project does not allow it")


def message_paragraphs(request):
    paragraphs = [request.subject]
    if request.body is not None:
        paragraphs.append(request.body)
    if request.trailers:
        paragraphs.append("\n".join(request.trailers))
    return paragraphs


def _cleaned(text):
    """`text` as git stores a message given with ``-m``: trailing space off each line, runs of blank lines
    collapsed, blank lines at either end dropped."""
    lines = [line.rstrip() for line in text.split("\n")]
    kept = []
    for line in lines:
        if line or (kept and kept[-1]):
            kept.append(line)
    return "\n".join(kept).strip("\n")


def validate_paths(root, paths, entries):
    """Refuse a path that is not one tracked or existing regular file of the repository, reached without
    a link or through a directory that holds its own repository. `entries` maps each indexed path to
    ``(mode, stage)``. Repositories with a gitlink are refused earlier, by `repo_program_findings`."""
    cache = {}
    seen = set()
    try:
        tree = safefs.Root(root, "repository")
    except safefs.SafeFsError as exc:
        raise Refused("the repository cannot be read safely: %s" % display.ascii_text(str(exc))[:200])
    with tree:
        def listing(directory):
            if directory not in cache:
                cache[directory] = tree.list_dir(directory, lenient=True)
            return cache[directory]

        for path in paths:
            label = shown(path, 80)
            try:
                parts = safefs.validate_relpath(path)
                if path.startswith("-") or any(c in path for c in "*?[]"):
                    raise Refused("path refused (a glob or an option): %s" % label)
                if path.casefold() in seen:
                    raise Refused("path named twice (or two spellings of one file): %s" % label)
                seen.add(path.casefold())
                if entries.get(path, ("", "0"))[1] != "0":
                    raise Refused("path has an unresolved merge state: %s" % label)
                present = False
                for depth in range(len(parts)):
                    found = listing("/".join(parts[:depth]))
                    if found is None:
                        break
                    if depth and any(name.casefold().rstrip(" .") == ".git" for name, _ in found):
                        raise Refused("path lies inside a nested repository: %s" % label)
                    kind = dict(found).get(parts[depth])
                    if kind is None:
                        break
                    if kind != ("dir" if depth < len(parts) - 1 else "file"):
                        raise Refused("path goes through, or is, a %s and not a file: %s" % (kind, label))
                    present = depth == len(parts) - 1
                if not present and path not in entries:
                    raise Refused("path does not exist and is not tracked: %s" % label)
                if not present:
                    # A tracked name the listing did not show may still be there under another spelling
                    # of the same name (Unicode normalisation): it must be a plain file or nothing.
                    try:
                        mode = os.lstat(os.path.join(root, *parts)).st_mode
                    except FileNotFoundError:
                        continue
                    except OSError as exc:
                        raise Refused("path refused: %s" % display.ascii_text(exc.strerror or "error"))
                    if not stat.S_ISREG(mode):
                        raise Refused("path is a link or not a file under another spelling: %s" % label)
            except safefs.SafeFsError as exc:
                raise Refused("path refused: %s" % display.ascii_text(str(exc))[:200])
    return paths


def indexed(root):
    """The index as ``{path: (mode, stage)}`` plus the raw text, for a comparison before and after."""
    listing = run(["git", "ls-files", "-s", "-z"], root).stdout
    found = {}
    for entry in listing.split("\0"):
        if not entry:
            continue
        meta, _, path = entry.partition("\t")
        fields = meta.split(" ")
        if len(fields) != 3:
            raise Refused("git listed the index in a form this helper does not read")
        found[path] = (fields[0], fields[2])
    return found, listing


def refuse_operation_in_progress(root):
    """A merge, revert, cherry-pick or rebase in progress would give the commit another parent or belong to
    that operation; this helper does not commit into one."""
    directory = run(["git", "rev-parse", "--absolute-git-dir"], root).stdout.strip()
    for name in ("MERGE_HEAD", "REVERT_HEAD", "CHERRY_PICK_HEAD", "rebase-merge", "rebase-apply", "sequencer"):
        if os.path.lexists(os.path.join(directory, name)):
            raise Refused("a %s is in progress in this repository; finish or abort it by hand"
                          % name.replace("_HEAD", "").replace("-", " ").lower())


def _expect_head(root, expected, when):
    now = head(root)
    if now != expected:
        raise Refused("HEAD moved %s: expected %s, found %s" % (when, expected[:12], now[:12]))


def _unstage(root, paths, expected):
    """Take the named paths out of the index again, but only while HEAD is still where it was expected."""
    try:
        if head(root) != expected:
            return "HEAD moved, so the index was left as it is"
        run(["git", "reset", "-q", "--"] + paths, root)
    except Refused as exc:
        return "the named paths could not be unstaged (%s)" % exc
    return "the named paths were unstaged"


def command_commit(argv, cwd, out, err):
    request = parse_commit(argv)
    validate_expected(request.expected)
    validate_message(request)
    refuse_attribution(request)
    root = git_root(cwd)
    found = repo_program_findings(root)
    if found:
        raise Refused("this repository would make git run a program (%s); commit by hand"
                      % ", ".join(found[:10]))
    refuse_operation_in_progress(root)
    paths = request.paths
    named = set(paths)
    _expect_head(root, request.expected, "before the commit was started")
    entries, before = indexed(root)
    validate_paths(root, paths, entries)
    staged = names(root, cached=True)
    if staged and not request.leave_other_staged:
        raise Refused("the index already holds staged changes (%d path(s)); use --leave-other-staged to keep "
                      "them out of this commit" % len(staged))
    if staged & named:
        raise Refused("a named path is already staged: %s" % shown(sorted(staged & named)[0], 80))
    problems = run(["git", "diff", "--check", "--no-ext-diff", "--no-textconv", "--"] + paths, root,
                   check=False)
    if problems.returncode:
        raise Refused("git diff --check finds whitespace errors in the named paths: %s"
                      % display.ascii_text(problems.stdout.strip())[:300])
    try:
        _expect_head(root, request.expected, "before staging")
        run(["git", "add", "--"] + paths, root)
        _expect_head(root, request.expected, "while staging")
        after_add = names(root, cached=True)
        if after_add != staged | named:
            missing = sorted((staged | named) - after_add)
            extra = sorted(after_add - staged - named)
            raise Refused("staging did not give exactly the named paths (no change: %s; extra: %s)"
                          % (shown(", ".join(missing), 120) or "none", shown(", ".join(extra), 120) or "none"))
        checked = run(["git", "diff", "--cached", "--check", "--no-ext-diff", "--no-textconv", "--"] + paths,
                      root, check=False)
        if checked.returncode:
            raise Refused("git diff --cached --check finds whitespace errors: %s"
                          % display.ascii_text(checked.stdout.strip())[:300])
        _expect_head(root, request.expected, "just before the commit")
        command = ["git", "commit", "--cleanup=whitespace"]
        for paragraph in message_paragraphs(request):
            command += ["-m", paragraph]
        if request.leave_other_staged:
            command += ["--only", "--"] + paths
        run(command, root)
    except Refused as exc:
        raise Refused("%s; %s" % (exc, _unstage(root, paths, request.expected)))
    return verify_commit(root, request, named, before, out)


def verify_commit(root, request, named, before, out):
    """Check what the commit holds; a failure here is reported with the commit and undoes nothing."""
    made = head(root)
    try:
        parents = run(["git", "rev-parse", "HEAD^@"], root).stdout.split()
        if parents != [request.expected]:
            raise Refused("HEAD moved during the commit; the commit %s was made on %s"
                          % (made[:12], ", ".join(p[:12] for p in parents) or "no parent"))
        expected_message = _cleaned("\n\n".join(message_paragraphs(request)))
        if _cleaned(run(["git", "show", "-s", "--format=%B", "HEAD"], root).stdout) != expected_message:
            raise Refused("the commit %s has a message other than the one asked for" % made[:12])
        changed = {item for item in run(["git", "diff-tree", "--no-commit-id", "--name-only", "-r", "-z",
                                         "HEAD"], root).stdout.split("\0") if item}
        if changed != named:
            raise Refused("the commit %s holds %s, not the named paths" % (made[:12], shown(", ".join(sorted(changed)), 120)))
        _, after = indexed(root)
        if _others(after, named) != _others(before, named):
            raise Refused("the commit %s was made but the rest of the index is not as it was" % made[:12])
        if head(root) != made:
            raise Refused("HEAD moved after the commit %s was made" % made[:12])
    except Refused as exc:
        raise Refused("%s; nothing was undone" % exc)
    out.write(json.dumps({"committed": made, "subject": request.subject, "paths": sorted(named)},
                         ensure_ascii=True) + "\n")
    return 0


def _others(listing, named):
    """The index listing without the entries of the named paths."""
    return sorted(entry for entry in listing.split("\0") if entry and entry.partition("\t")[2] not in named)


COMMANDS = {"check": command_check, "plans": command_plans, "report": command_report}
CHANGING = {"commit": command_commit}


def main(argv, out, err, cwd):
    """Run one subcommand from `cwd`. Returns the exit code."""
    try:
        if argv and argv[0] in CHANGING:
            return CHANGING[argv[0]](argv[1:], cwd, out, err)
        if len(argv) != 1 or argv[0] not in COMMANDS:
            raise Refused("usage: code-work %s (no arguments)" % "|".join(sorted(COMMANDS)))
        return COMMANDS[argv[0]](find_root(cwd), out, err)
    except Refused as exc:
        err.write("refused: %s\n" % exc)
        return 1
    except OSError as exc:
        err.write("failed: %s\n" % shown(exc.strerror or exc))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdout, sys.stderr, os.getcwd()))
