#!/usr/bin/env python3
"""The safe-git helper: makes one local commit of exactly the named files, and removes exact paths.

It is one file that imports the standard library and the workbench kit (``wbkit``); the launcher runs a
private copy of it through the kit runner with nothing beside it.

    safe-git commit     make one local commit of exactly the named files (see `parse_commit`)
    safe-git remove     preview, and with --confirm delete, exact paths of the repository
    safe-git push-check report, read-only, what a push of the current branch would send (see `command_push_check`)

The rules are in ``docs/specs/safe-git.md``. It starts one program, ``git``, found on a PATH entry
outside the repository, with an environment built here, and only in one of the shapes listed in
`git_shape_ok`. The repository is untrusted: its configuration and hooks are read for the names of
anything that would make git run a program, and a commit is refused when there is one. The owner's own
global and system Git configuration is trusted. It never reads or writes the guarded store.
"""

import difflib
import errno
import json
import os
import re
import stat
import sys
import time
import unicodedata

from wbkit import display, jsonstrict, safefs

_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)


class Refused(Exception):
    """Nothing was done; the message says why. `code` names the class of refusal for `describe`, which reports
    it as data; the real commands print the message only."""

    def __init__(self, message="", code=None):
        super().__init__(message)
        self.code = code


def shown(text, limit=120):
    """`text` with every character outside printable ASCII written as an escape, cut to `limit`."""
    out = []
    for char in str(text)[:limit]:
        if " " <= char <= "~":
            out.append(char)
        elif ord(char) < 0x100:
            out.append("\\x%02x" % ord(char))
        elif ord(char) < 0x10000:
            out.append("\\u%04x" % ord(char))
        else:
            out.append("\\U%08x" % ord(char))
    return "".join(out)


FALLBACK_PATH = ["/usr/bin", "/bin"]
GIT_TIMEOUT = 120
MAX_REF = 200
MAX_GITLINK_FINDINGS = 5
MAX_SCAN = 8 * 1024 * 1024
MAX_FINDINGS = 100
MAX_CHANGED = 500
_KEPT = ("HOME", "XDG_CONFIG_HOME", "USER", "LOGNAME", "LANG", "TZ", "TERM", "TMPDIR")
_BRANCH = re.compile(r"\Arefs/heads/[A-Za-z0-9._][A-Za-z0-9._/-]*\Z")
_TRACKING = re.compile(r"\Arefs/remotes/[A-Za-z0-9_][A-Za-z0-9._-]{0,63}/[A-Za-z0-9._][A-Za-z0-9._/-]*\Z")
_REMOTE_HEAD = re.compile(r"\Arefs/remotes/[A-Za-z0-9_][A-Za-z0-9._-]{0,63}/HEAD\Z")
_REMOTE_NAME = re.compile(r"\A[A-Za-z0-9_][A-Za-z0-9._-]{0,63}\Z")
_RANGE = re.compile(r"\A[0-9a-f]{40}\.\.HEAD\Z")
_DIFF_FLAGS = ("--cached", "--name-only", "-z", "--check", "--no-ext-diff", "--no-textconv", "--no-renames",
               "--no-color", "-U0", "--diff-filter=d", "--src-prefix=a/", "--dst-prefix=b/", "--text",
               "--ignore-submodules=all")
# A log of patches for `push-check`: these flags, and every one of the first group.
_LOG_REQUIRED = {"--no-merges", "-p", "--format=", "--no-show-signature", "--no-ext-diff", "--no-textconv",
                 "--ignore-submodules=all"}
_LOG_FLAGS = _LOG_REQUIRED | {"--no-renames", "--no-color", "-U0", "--src-prefix=a/", "--dst-prefix=b/", "--text"}
# Repository settings shaped like "a program or command to run": the shape decides and not a list of
# names, because a list kept missing keys. A key is lower-cased before it is matched.
EXEC_KEY = re.compile(
    r".*\.(program|command|driver|cmd|clean|smudge|process|textconv|external|defaultkeycommand"
    r"|uploadpack|receivepack|vcs|helper|promisor|partialclone|partialclonefilter)"
    r"|core\.(hookspath|fsmonitor|sshcommand|gitproxy|askpass)|.*hook")


def is_inside(path, boundary):
    """True when `path` is `boundary` or below it, whatever links and case spellings lead there. A part of the
    path that does not exist yet is skipped (it cannot be the boundary, but something may be put there later),
    and a part that cannot be examined counts as inside."""
    current = os.path.realpath(path)
    while True:
        try:
            if os.path.samefile(current, boundary):
                return True
        except FileNotFoundError:
            pass
        except OSError:
            return True
        parent = os.path.dirname(current)
        if parent == current:
            return False
        current = parent


def repository_boundary(start):
    """The nearest ancestor of `start` that holds a `.git` entry, found without running git."""
    current = os.path.realpath(start)
    while True:
        if os.path.lexists(os.path.join(current, ".git")):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return os.path.realpath(start)
        current = parent


def outermost_boundary(start):
    """The outermost ancestor of `start` that holds a `.git` entry. A PATH entry is trusted only when it is
    outside this one, so a repository embedded in another cannot make the outer one look outside."""
    current = os.path.realpath(start)
    found = None
    while True:
        if os.path.lexists(os.path.join(current, ".git")):
            found = current
        parent = os.path.dirname(current)
        if parent == current:
            return found or os.path.realpath(start)
        current = parent


def trusted_path_entries(boundary):
    """The PATH entries that are absolute, are directories that exist now and are outside the repository: never "",
    "." or a relative one, and never one that is missing or cannot be examined (a missing one that goes up through
    ".." could later name a place inside the repository)."""
    return [entry for entry in os.environ.get("PATH", "").split(os.pathsep)
            if entry and os.path.isabs(entry) and os.path.isdir(entry) and not is_inside(entry, boundary)]


def trusted_which(name, boundary, entries=None):
    """The first executable `name` in a trusted entry that does not resolve into the repository."""
    for entry in trusted_path_entries(boundary) if entries is None else entries:
        candidate = os.path.join(entry, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) \
                and not is_inside(candidate, boundary):
            return candidate
    return None


def git_environment(entries, extra=None):
    """The environment git runs in: a short list of the caller's variables, the trusted PATH and the
    few Git variables set here. No variable of the caller that starts with GIT_ is passed. A repository's
    file system monitor is switched off, a missing object is never fetched and no maintenance runs after a
    commit, because each could run a program the repository names."""
    env = {name: os.environ[name] for name in _KEPT if name in os.environ}
    env.update({name: value for name, value in os.environ.items() if name.startswith("LC_")})
    env["PATH"] = os.pathsep.join(entries)
    env.update({"GIT_NO_REPLACE_OBJECTS": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_EDITOR": "true",
                "GIT_PAGER": "cat", "GIT_LITERAL_PATHSPECS": "1", "GIT_NO_LAZY_FETCH": "1",
                "GIT_CONFIG_COUNT": "3", "GIT_CONFIG_KEY_0": "core.fsmonitor", "GIT_CONFIG_VALUE_0": "false",
                "GIT_CONFIG_KEY_1": "maintenance.auto", "GIT_CONFIG_VALUE_1": "false",
                "GIT_CONFIG_KEY_2": "gc.auto", "GIT_CONFIG_VALUE_2": "0"})
    env.update(extra or {})
    return env


def _plain_ref(ref, pattern):
    return (isinstance(ref, str) and len(ref) <= MAX_REF + 11 and pattern.match(ref) is not None
            and ".." not in ref and "//" not in ref and not ref.endswith(("/", ".")) and "@{" not in ref
            and all(not part.startswith(".") and not part.endswith(".lock") for part in ref.split("/")))


def _branch_ref(ref):
    return _plain_ref(ref, _BRANCH)


def _scan_ref(ref):
    """A local branch or a remote-tracking branch, written out in full."""
    return _plain_ref(ref, _BRANCH) or _plain_ref(ref, _TRACKING)


def _paths_ok(paths):
    """True for one or more repository-relative paths: none empty, absolute or naming a `..` component, so
    a path cannot leave the repository (git treats two paths outside the work tree as ``--no-index``)."""
    return bool(paths) and all(item and not item.startswith("/") and ".." not in item.split("/")
                               for item in paths)


def _after_dashes(rest, start):
    """True when `rest` has `--` at `start` and, after it, one or more paths that stay in the repository."""
    return rest[start:start + 1] == ["--"] and _paths_ok(rest[start + 1:])


def _flags_ok(flags):
    return len(set(flags)) == len(flags) and ("--name-only" in flags
                                              or ("--no-ext-diff" in flags and "--no-textconv" in flags))


def _diff_shape(rest):
    """A diff in the allowed flags. One that reads file contents must also switch off external diff and
    text conversion, so a program a configuration names is never started by it."""
    flags = []
    for index, item in enumerate(rest):
        if item == "--":
            return _flags_ok(flags) and _after_dashes(rest, index)
        if index == len(rest) - 1 and _RANGE.match(item):   # `<40 hex>..HEAD`, last, and no paths after it
            return _flags_ok(flags)
        if item not in _DIFF_FLAGS:
            return False
        flags.append(item)
    return _flags_ok(flags) and bool(flags)


def _head_blob(argument):
    """``HEAD:<path>`` for a path that stays in the repository and has no empty or ``.`` segment."""
    path = argument[5:] if isinstance(argument, str) and argument.startswith("HEAD:") else None
    return path is not None and _paths_ok([path]) and all(part not in ("", ".") for part in path.split("/"))


_CONVERTING = ("filter", "ident", "working-tree-encoding")


def _literal(path):
    """A path git reads as the file it names: no leading colon (pathspec magic), glob or escape, and no leading dash."""
    return not path.startswith(("-", ":")) and not any(char in path for char in "*?[]\\")


def _commit_shape(rest):
    start = 1 if rest[:1] == ["--cleanup=whitespace"] else 0
    index = start
    while rest[index:index + 1] == ["-m"] and index + 1 < len(rest):
        index += 2
    if index == start:
        return False
    tail = rest[index:]
    return tail == [] or (tail[:2] == ["--only", "--"] and _paths_ok(tail[2:]))


_SHAPES = {
    "rev-parse": lambda rest: rest in (["--show-toplevel"], ["--absolute-git-dir"], ["--git-common-dir"],
                                       ["HEAD"], ["--verify", "HEAD"], ["HEAD^@"])
    or (len(rest) == 3 and rest[:2] == ["--verify", "-q"] and _branch_ref(rest[2])),
    "diff": _diff_shape,
    "show-ref": lambda rest: len(rest) == 3 and rest[:2] == ["--verify", "--hash"] and _scan_ref(rest[2]),
    "symbolic-ref": lambda rest: rest == ["-q", "HEAD"] or (
        len(rest) == 3 and rest[:2] == ["-q", "--short"] and _plain_ref(rest[2], _REMOTE_HEAD)),
    "log": lambda rest: bool(rest) and _RANGE.match(rest[-1]) is not None and len(set(rest[:-1])) == len(rest) - 1
    and set(rest[:-1]) <= _LOG_FLAGS and _LOG_REQUIRED <= set(rest[:-1]),
    "rev-list": lambda rest: len(rest) == 2 and rest[0] == "--count" and _RANGE.match(rest[1]) is not None,
    "ls-files": lambda rest: (rest[:2] == ["--error-unmatch", "--"] and _paths_ok(rest[2:]))
    or rest == ["-s", "-z"] or (rest[:3] == ["-s", "-z", "--"] and _paths_ok(rest[3:]))
    or (rest[:2] == ["-z", "--"] and _paths_ok(rest[2:])),
    "cat-file": lambda rest: len(rest) == 2 and rest[0] in ("-s", "blob") and _head_blob(rest[1]),
    "check-attr": lambda rest: rest[:1 + len(_CONVERTING)] == ["-z"] + list(_CONVERTING)
    and _after_dashes(rest, 1 + len(_CONVERTING)),
    "check-ignore": lambda rest: len(rest) == 3 and rest[:2] == ["-q", "--"] and _paths_ok(rest[2:])
    and _literal(rest[2]),
    "add": lambda rest: _after_dashes(rest, 0),
    "commit": _commit_shape,
    "reset": lambda rest: rest[:1] == ["-q"] and _after_dashes(rest, 1),
    "show": lambda rest: rest in (["-s", "--format=%s", "HEAD"], ["-s", "--format=%B", "HEAD"]),
    "diff-tree": lambda rest: rest in (
        ["--no-commit-id", "--name-only", "-r", "-z", "HEAD"],
        ["--root", "--no-commit-id", "--name-only", "-r", "-z", "HEAD"]),
    "config": lambda rest: rest in (["--list", "-z"], ["--list", "--show-scope", "-z"]),
    "remote": lambda rest: len(rest) == 4 and rest[:3] == ["get-url", "--push", "--all"]
    and _REMOTE_NAME.match(rest[3]) is not None,
    "status": lambda rest: rest == ["--porcelain=v1", "-z", "--untracked-files=all"],
}


def git_shape_ok(argv):
    """Whether `argv` is `git` and one of the few commands in the shapes this helper runs. Anything
    else, a global option before the subcommand included, is not run."""
    if not isinstance(argv, list) or len(argv) < 2 or argv[0] != "git" \
            or not all(type(item) is str and "\0" not in item for item in argv):
        return False
    shape = _SHAPES.get(argv[1])
    return shape is not None and bool(shape(argv[2:]))


def _resolve_git(argv, cwd):
    """The path of the trusted ``git`` and the PATH entries it runs with, after checking the shape of `argv`."""
    if not git_shape_ok(argv):
        raise Refused("this helper does not run that git command: %s"
                      % display.ascii_text(" ".join(str(item)[:60] for item in argv[:3]))[:200])
    boundary = outermost_boundary(cwd)
    entries = trusted_path_entries(boundary) or FALLBACK_PATH
    found = trusted_which("git", boundary, entries)
    if found is None:
        raise Refused("git was not found in an absolute PATH entry outside the repository",
                      code="repository_unreadable")
    return found, entries


def run(argv, cwd, check=True, timeout=GIT_TIMEOUT, env_extra=None):
    """Run `argv` (``git`` and a command in an allowed shape) in `cwd`; return the finished process.
    Raises ``Refused`` for a shape that is not allowed, a missing git, a timeout, or (with `check`) a
    nonzero exit."""
    import subprocess   # the one program this helper starts; imported here, below the read-only part
    found, entries = _resolve_git(argv, cwd)
    try:
        result = subprocess.run([found] + argv[1:], cwd=cwd, capture_output=True, text=True,
                                encoding="utf-8", errors="surrogateescape", check=False,
                                env=git_environment(entries, env_extra), timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Refused("git %s did not finish within %d seconds" % (argv[1], timeout), code="repository_unreadable")
    except OSError as exc:
        raise Refused("git %s could not be started (%s)" % (argv[1], display.ascii_text(exc.strerror or "error")),
                      code="repository_unreadable")
    if check and result.returncode:
        detail = (result.stderr or result.stdout or "no message").strip()[-300:]
        raise Refused("git %s failed (%d): %s" % (argv[1], result.returncode, display.ascii_text(detail)),
                      code="repository_unreadable")
    return result


def run_capped(argv, cwd, limit, timeout=None, separator="\n"):
    """Run `argv` like `run`, reading at most `limit` bytes of its output. Returns ``(text, truncated)``:
    when the output is longer, git and anything it started are stopped and the text ends at the last
    `separator`. Standard error is discarded. Raises ``Refused`` for a shape that is not allowed, a missing git, a
    timeout or a nonzero exit of a run that was not cut."""
    import select       # read below the cap, with a deadline, and no thread
    import signal
    import subprocess   # the same one program as `run`
    import time
    found, entries = _resolve_git(argv, cwd)
    deadline = time.monotonic() + (GIT_TIMEOUT if timeout is None else timeout)
    try:
        child = subprocess.Popen([found] + argv[1:], cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, env=git_environment(entries), start_new_session=True)
    except OSError as exc:
        raise Refused("git %s could not be started (%s)" % (argv[1], display.ascii_text(exc.strerror or "error")))
    chunks, size, truncated = [], 0, False
    try:
        fd = child.stdout.fileno()
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise Refused("git %s did not finish within %d seconds" % (argv[1], timeout))
            if not select.select([fd], [], [], min(left, 1.0))[0]:
                continue
            data = os.read(fd, 65536)
            if not data:
                break
            if size + len(data) > limit:
                chunks.append(data[:limit - size])
                truncated = True
                break
            chunks.append(data)
            size += len(data)
    finally:
        try:
            os.killpg(child.pid, signal.SIGKILL)   # git has its own process group, so what it started goes too
        except OSError:
            pass
        child.stdout.close()
        child.wait()
    if not truncated and child.returncode:
        raise Refused("git %s failed (%d)" % (argv[1], child.returncode))
    text = b"".join(chunks).decode("utf-8", "surrogateescape")
    if truncated:
        text = text[:text.rfind(separator) + 1]
    return text, truncated


def git_root(path):
    """The root of the repository that holds `path`, after refusing a work tree or git directory that is
    not the repository's own `.git`: a `core.worktree` redirect, an embedded or separate repository, and a
    `.git` that is a link."""
    path = os.path.realpath(path)
    top = os.path.realpath(run(["git", "rev-parse", "--show-toplevel"], path).stdout.strip())
    holder = repository_boundary(path)
    try:
        same = os.path.samefile(top, holder)
    except OSError:
        same = False
    if not same:
        raise Refused("git reports a work tree that is not the repository holding its metadata "
                      "(a core.worktree redirect?); refusing to act", code="repository_unreadable")
    marker = os.path.join(top, ".git")
    if os.path.islink(marker):
        raise Refused("the repository's .git is a link; refusing to act", code="repository_unreadable")
    if os.path.isdir(marker):
        gitdir = run(["git", "rev-parse", "--absolute-git-dir"], path).stdout.strip()
        if os.path.realpath(gitdir) != os.path.realpath(marker):
            raise Refused("git is using a git directory that is not the repository's own .git "
                          "(an embedded or bare repository?); refusing to act", code="repository_unreadable")
    else:
        raise Refused("the repository's .git is not a directory (a separate git directory or a work tree "
                      "of another repository?); refusing to act", code="repository_unreadable")
    if os.path.commonpath([path, top]) != top:
        raise Refused("the working directory is outside the repository root git reports; refusing to act",
                      code="repository_unreadable")
    return top


def head(root):
    return run(["git", "rev-parse", "HEAD"], root).stdout.strip()


def names(root, cached=False):
    """The paths git reports as changed in the work tree, or (with `cached`) staged."""
    command = ["git", "diff"] + (["--cached"] if cached else []) + ["--no-renames", "--name-only", "-z"]
    return {item for item in run(command, root).stdout.split("\0") if item}


def git_bool_is_true(has_value, value):
    """A Git boolean as Git reads it: a key with no value is true, an integer is true unless zero, and
    only the empty string, false, no, off and 0 are false. Anything unrecognised is true, the cautious
    reading."""
    if not has_value:
        return True
    text = value.strip().lower()
    if text in ("", "false", "no", "off"):
        return False
    try:
        return int(text, 0) != 0
    except ValueError:
        return True


def _without_subsection(key):
    """`key` with its subsection left out (``credential.*.helper``): a subsection can be a URL that carries a
    credential. A key with no subsection is returned as it is."""
    section, _, rest = key.partition(".")
    subsection, dot, variable = rest.rpartition(".")
    return "%s.*.%s" % (section, variable) if dot else key


def repo_program_findings(root, redact=False):
    """The names, never the values, of repository settings and hooks that make a commit run a program. With `redact`
    a key is named without its subsection, before it is cut to length, so no part of a URL in a subsection is kept."""
    findings = []
    quiet = {"GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1"}
    listing = run(["git", "config", "--list", "-z"], root, check=False, env_extra=quiet)
    if listing.returncode:
        return ["config:unreadable"]
    for entry in listing.stdout.split("\0"):
        key, separator, value = entry.partition("\n")
        lowered = key.lower()
        if lowered == "core.fsmonitor" and not git_bool_is_true(bool(separator), value):
            continue   # off, as the runner itself sets it
        if EXEC_KEY.fullmatch(lowered) or (lowered == "commit.gpgsign"
                                           and git_bool_is_true(bool(separator), value)):
            findings.append(display.ascii_text(_without_subsection(key) if redact else key)[:80])
    for flag in ("--absolute-git-dir", "--git-common-dir"):
        directory = run(["git", "rev-parse", flag], root).stdout.strip()
        hooks = os.path.join(directory if os.path.isabs(directory) else os.path.join(root, directory), "hooks")
        try:
            listed = sorted(os.listdir(hooks))
        except (FileNotFoundError, NotADirectoryError):
            continue
        except OSError:      # git needs only search permission to run a hook it names
            findings.append("hooks:unreadable")
            continue
        for name in listed:
            path = os.path.join(hooks, name)
            if not name.endswith(".sample") and os.path.isfile(path) and os.access(path, os.X_OK):
                findings.append("hook:" + display.ascii_text(name)[:60])
    listing = run(["git", "ls-files", "-s", "-z"], root, check=False)
    if listing.returncode:
        findings.append("index:unreadable")
    else:
        # A committed gitlink is a nested repository: git starts a child in it for `diff`, `status` and
        # `commit`, and that child reads the nested repository's own configuration, which is not read above.
        links = [entry.partition("\t")[2] for entry in listing.stdout.split("\0")
                 if entry.startswith("160000 ")]
        findings.extend("submodule:" + display.ascii_text(path)[:60] for path in links[:MAX_GITLINK_FINDINGS])
    return sorted(set(findings))


