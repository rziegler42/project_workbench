def _intent_to_add(listing):
    """The paths the index lists with the empty blob: what ``git add -N`` leaves, a path HEAD does not hold."""
    found = set()
    for entry in listing.split("\0"):
        meta, _, path = entry.partition("\t")
        fields = meta.split(" ")
        if len(fields) == 3 and fields[1] in _EMPTY_BLOBS:
            found.add(path)
    return found


def _head_side(root, path, may_be_absent):
    """What HEAD holds at `path`: ``("absent",)`` where `may_be_absent` (an intent-to-add path), ``("large", size)``
    for a blob over `MAX_SIDE`, whose size is asked first so that it is never read, or ``("blob", data)``. Git is asked
    only for the size and then the content. A blob git cannot give for any other path is an unreadable repository."""
    probe = run(["git", "cat-file", "-s", "HEAD:" + path], root, check=False)
    if probe.returncode:
        if may_be_absent:
            return ("absent",)
        raise Refused("git cat-file cannot read HEAD:%s" % shown(path, 80), code="repository_unreadable")
    if not re.fullmatch(r"[0-9]{1,15}", probe.stdout.strip()):
        raise Refused("git cat-file gave a size this helper does not read", code="repository_unreadable")
    size = int(probe.stdout)
    if size > MAX_SIDE:
        return ("large", size)
    try:
        text, cut = run_capped(["git", "cat-file", "blob", "HEAD:" + path], root, size + 1)
    except Refused as exc:
        raise Refused(str(exc), code="repository_unreadable")
    data = text.encode("utf-8", "surrogateescape")
    if cut or len(data) != size:
        raise Refused("git cat-file gave a blob that is not the size it reported", code="repository_unreadable")
    return ("blob", data)


def _lines(data):
    """The lines of `data` as git splits them, on the line feed only; a last line with none is marked. Only UTF-8 text
    is shown (`_change_facts` sets any other aside as binary)."""
    pieces = data.decode("utf-8", "backslashreplace").split("\n")
    lines = [piece + "\n" for piece in pieces[:-1]]
    if pieces[-1]:
        lines.append(pieces[-1] + "\n\\ No newline at end of file\n")
    return lines


def _range(start, stop):
    """A range of a hunk header, as ``difflib`` writes it: the first line (counted from 1) and the count."""
    first, length = start + 1, stop - start
    if length == 1:
        return str(first)
    return "%d,%d" % (first - 1 if not length else first, length)


def _text_diff(path, old, new):
    """The unified diff of `old` against `new`, named ``HEAD/<path>`` and ``work/<path>``; empty when they are equal;
    ``None`` when more than `MAX_MIDDLE` lines differ. The lines both sides share at the start and the end are set
    aside before they are compared, so a long file with a small change costs little."""
    first, second = _lines(old), _lines(new)
    if first == second:
        return ""
    head = 0
    while head < min(len(first), len(second)) and first[head] == second[head]:
        head += 1
    tail = 0
    while tail < min(len(first), len(second)) - head and first[-1 - tail] == second[-1 - tail]:
        tail += 1
    middle = (first[head:len(first) - tail], second[head:len(second) - tail])
    if max(len(middle[0]), len(middle[1])) > MAX_MIDDLE:
        return None
    codes = [("equal", 0, head, 0, head)] if head else []
    codes += [(tag, a + head, b + head, c + head, d + head)
              for tag, a, b, c, d in difflib.SequenceMatcher(None, *middle, autojunk=False).get_opcodes()]
    if tail:
        codes.append(("equal", len(first) - tail, len(first), len(second) - tail, len(second)))
    matcher = difflib.SequenceMatcher(None, [], [])
    matcher.opcodes = codes
    lines = ["--- HEAD/%s\n" % path, "+++ work/%s\n" % path]
    for group in matcher.get_grouped_opcodes(3):
        lines.append("@@ -%s +%s @@\n" % (_range(group[0][1], group[-1][2]), _range(group[0][3], group[-1][4])))
        for tag, a, b, c, d in group:
            if tag == "equal":
                lines += [" " + line for line in first[a:b]]
                continue
            if tag in ("replace", "delete"):
                lines += ["-" + line for line in first[a:b]]
            if tag in ("replace", "insert"):
                lines += ["+" + line for line in second[c:d]]
    return "".join(lines)


def _utf8(data):
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return True


def _mode_line(path, old, new):
    """A line for a change of mode, with ``none`` for a side that is not there; none for a plain new or deleted file."""
    if old == new or (old is None and new == "100644") or (new is None and old == "100644"):
        return ""
    return "mode HEAD/%s %s -> work/%s %s\n" % (path, old or "none", path, new or "none")


def _change_facts(checked, facts):
    """Fill the change lists and the diff of the checked paths, HEAD against the work tree, byte for byte: no git
    filter, text conversion or external diff, and no link followed. Nothing is set unless all of it is found."""
    root, paths, entries = checked.root, checked.request.paths, checked.entries
    in_head = checked.request.expected is not None
    lists = {name: [] for name in _CHANGE_LISTS}
    pieces, length, left_out = [], 0, False
    deadline = time.monotonic() + DIFF_BUDGET
    intent = _intent_to_add(checked.before)
    try:
        root_fd = safefs.open_root(root, "repository")
    except safefs.SafeFsError as exc:
        raise Refused("the repository cannot be read safely: %s" % display.ascii_text(str(exc))[:200],
                      code="repository_unreadable")
    try:
        for path in paths:
            try:
                old = _head_side(root, path, path in intent) if in_head and path in entries else ("absent",)
                new = _read_work(root_fd, path.split("/"))
            except Refused as exc:
                raise Refused(str(exc), code=exc.code or "repository_unreadable")
            except OSError as exc:
                raise Refused("path refused: %s" % display.ascii_text(exc.strerror or "error"), code="path_refused")
            if new[0] == "irregular":
                lists["not_regular_paths"].append(path)
                continue
            if old[0] == "absent" and new[0] == "absent":
                continue      # gone from both sides since the checks: there is nothing to say of it
            old_mode = entries[path][0] if old[0] != "absent" else None
            new_mode = new[2] if new[0] != "absent" else None
            if new[0] == "absent":
                kind = "deleted_paths"
            elif old[0] == "absent":
                kind = "new_paths"
            elif "large" in (old[0], new[0]):
                kind = "modified_paths"      # not read, so not compared: the cautious reading
            elif old[1] == new[1] and old_mode == new_mode:
                kind = "unchanged_paths"
            else:
                kind = "modified_paths"
            lists[kind].append(path)
            if "large" in (old[0], new[0]):
                left_out = True
                continue
            before = old[1] if old[0] == "blob" else b""
            after = new[1] if new[0] == "file" else b""
            if b"\0" in before or b"\0" in after or not (_utf8(before) and _utf8(after)):
                lists["binary_paths"].append(path)
            elif length <= MAX_DIFF:     # counted in characters, never more than bytes; past the cap the diff is left out whole, so the rest is not worked out
                text = _text_diff(path, before, after) if time.monotonic() <= deadline else None
                if text is None:
                    left_out = True      # too much differs to compare, or the budget is spent
                    continue
                piece = _mode_line(path, old_mode, new_mode) + text
                pieces.append(piece)
                length += len(piece)
    finally:
        os.close(root_fd)
    facts.update(lists)
    facts["diff"] = OMIT if left_out else "".join(pieces)


def _given_commit(argv):
    """``(leave_other_staged, paths)`` of a command line that `parse_commit` refused, read as it reads them: an option
    that takes a value takes the next word whatever it is, so that word may be ``--`` or another option. A command
    line it accepts is reported from its request instead."""
    leave, index = False, 0
    while index < len(argv) and argv[index] != "--":
        if argv[index] == "--leave-other-staged":
            leave, index = True, index + 1
        elif argv[index] in _COMMIT_OPTIONS and index + 1 < len(argv):
            index += 2
        else:
            index += 1
    return leave, ([] if index >= len(argv) else argv[index + 1:])


def describe_commit(argv, cwd):
    """``(errors, facts)`` of `commit <argv>`: the checks the real command makes through `git diff --check`, the facts
    they establish, and the change lists and the diff of the named paths. Nothing is staged and nothing is committed."""
    leave, given = _given_commit(argv)
    facts = {"head": None, "expected_head": None, "leave_other_staged": leave,
             "path_count": len(given), "subject": None, "trailers": [], "body": None,
             "attribution_allowed": None, "program_findings": [], "staged_paths": [],
             "requested_paths": given, "paths": [], "diff": None}
    facts.update((name, []) for name in _CHANGE_LISTS)
    errors = []
    try:
        _change_facts(check_commit(argv, cwd, note=facts.__setitem__), facts)
    except Refused as exc:
        if exc.code is None:
            raise      # a refusal with no code has no place in the tables: stop with no object, as a decline
        errors.append((exc.code, str(exc)))
    return errors, [(name, facts[name]) for name in _COMMIT_FACTS]


# --- describe push -------------------------------------------------------------------------------

# `describe push` takes the arguments that follow `git push` and has no real command of this module to share their
# validation with, so this parser is the validation: a fixed grammar, and anything else is `usage` (spec: "The
# grammar"). No message quotes an argument: a remote argument can be a URL that carries a credential.
_PUSH_FLAGS = {"-f": "force", "--force": "force", "--force-with-lease": "force_with_lease", "-d": "delete",
               "--delete": "delete", "-u": "set_upstream", "--set-upstream": "set_upstream",
               "--no-verify": "no_verify", "-n": "dry_run", "--dry-run": "dry_run", "--atomic": "atomic",
               "-q": "quiet", "--quiet": "quiet", "-v": "verbose", "--verbose": "verbose"}
_REMOTE_STATE_FLAGS = ("--mirror", "--follow-tags")
_PUSH_NAME = re.compile(r"\A[A-Za-z0-9._][A-Za-z0-9._/-]*\Z")
_PUSH_FLAG_FACTS = ("force", "delete", "set_upstream", "no_verify", "dry_run", "atomic")
_PUSH_FACTS = ("head", "branch", "remote", "default_branch", "force", "delete", "set_upstream", "no_verify",
               "dry_run", "atomic", "remote_scheme", "remote_url_has_credentials", "push_config_findings",
               "push_updates", "push_deletes", "push_forced", "base", "ahead",
               "tracking_ref_reflog_looks_git_written", "commit_hashes", "commit_messages", "changed_paths",
               "binary_paths", "submodule_paths", "findings", "diff")


class PushRequest:
    """What the arguments of a push say: the flags given (by their fact names), the remote named (or None), the
    updates as ``(source, destination, forced)`` and the destinations to delete."""

    def __init__(self):
        self.flags, self.remote, self.updates, self.deletes = set(), None, [], []


def _usage(what):
    return Refused("usage: safe-git describe push [flags] [remote [refspec...]]: %s" % what, code="usage")


def _push_ref(text):
    return _plain_ref(text, _PUSH_NAME)


def parse_push(argv):
    """The `PushRequest` of the arguments after ``git push``. Refuses with ``usage`` anything outside the grammar,
    and with ``remote_state_required`` a form whose targets depend on what the remote holds."""
    request, spelled, index = PushRequest(), set(), 0
    while index < len(argv) and argv[index].startswith("-"):
        item = argv[index]
        if item in _REMOTE_STATE_FLAGS:
            raise Refused("a push with --mirror or --follow-tags sends what the remote's refs decide, so it cannot "
                          "be described from local data", code="remote_state_required")
        name = _PUSH_FLAGS.get(item)
        if name is None:
            raise _usage("a flag that is not accepted")
        if name in spelled:
            raise _usage("a flag given twice")
        spelled.add(name)
        request.flags.add("force" if name == "force_with_lease" else name)
        index += 1
    rest = argv[index:]
    if not rest:
        if "delete" in spelled:
            raise _usage("--delete needs a remote and a destination")
        return request
    if _REMOTE_NAME.match(rest[0]) is None:
        raise _usage("the remote must be a configured name, not a URL or a path")
    request.remote = rest[0]
    deleting = "delete" in spelled
    for text in rest[1:]:
        if text.startswith(("-", "^")) or text in ("", "+"):
            raise _usage("a refspec that is not accepted")
        forced = text.startswith("+")
        body = text[1:] if forced else text
        if "*" in body:
            raise Refused("a wildcard refspec sends what the remote's refs decide, so it cannot be described "
                          "from local data", code="remote_state_required")
        source, colon, destination = body.partition(":")
        if ":" in destination or (deleting and (colon or forced)):
            raise _usage("a refspec that is not accepted")
        if deleting or (colon and not source):
            if (colon and forced) or not _push_destination(destination if colon else source):
                raise _usage("a refspec that is not accepted")
            request.deletes.append(destination if colon else source)
        else:
            if not _push_ref(source) or (colon and not _push_destination(destination)):
                raise _usage("a refspec that is not accepted")
            request.updates.append((source, destination if colon else source, forced))
    if len(request.updates) > 1 or (request.updates and request.deletes) or (deleting and not request.deletes):
        raise _usage("a push is one update, or deletions only")
    return request


def _push_destination(text):
    """A destination: a name, or a full ref under ``refs/heads/`` or ``refs/tags/``."""
    return (_push_ref(text) and text != "HEAD"
            and (not text.startswith("refs/") or text.startswith(("refs/heads/", "refs/tags/"))))


def config_entries(root):
    """The configuration git reads, in its order, as ``[(scope, section, subsection or None, variable, value or
    None)]``: the section and variable lower-case, the subsection as written, and a key with no value None."""
    listing = run(["git", "config", "--list", "--show-scope", "-z"], root, check=False)
    fields = listing.stdout.split("\0")
    if fields and fields[-1] == "":
        fields.pop()
    if listing.returncode or len(fields) % 2:
        raise Refused("git could not list its configuration", code="repository_unreadable")
    entries = []
    for scope, entry in zip(fields[0::2], fields[1::2]):
        key, separator, value = entry.partition("\n")
        section, _, rest = key.partition(".")
        subsection, dot, variable = rest.rpartition(".")
        entries.append((scope, section.lower(), subsection if dot else None, variable.lower(),
                        value if separator else None))
    return entries


def push_remote(entries, branch, given):
    """The remote a push goes to: `given`, else the first set of ``branch.<name>.pushRemote``, ``remote.pushDefault``
    and ``branch.<name>.remote``, else ``origin``. A value that is not a remote name is ``target_unresolved``."""
    if given is not None:
        return given
    last = {}
    for _, section, subsection, variable, value in entries:
        last[(section, subsection, variable)] = value
    for key in (("branch", branch, "pushremote"), ("remote", None, "pushdefault"), ("branch", branch, "remote")):
        if key in last:
            value = last[key]
            if value is None or _REMOTE_NAME.match(value) is None:
                raise Refused("the remote a push would use, from the configuration, is not a remote name",
                              code="target_unresolved")
            return value
    return "origin"


# The settings that redirect or intercept a push, or make it run a program (spec: "Resolution and the remote"). They
# are named by `<section>.<variable>`, and a subsectioned key without its subsection (`credential.*.helper`), because a
# subsection can be a URL that carries a credential. A key of the repository is refused; one of the owner's is named.
_PUSH_SETTINGS = {("http", "proxy"), ("https", "proxy"), ("credential", "helper"), ("ssh", "variant"),
                  ("core", "sshcommand"), ("core", "gitproxy"), ("core", "askpass"), ("push", "gpgsign"),
                  ("push", "pushoption"), ("push", "recursesubmodules"), ("push", "negotiate")}
_SUBSECTIONED = {"http", "https", "credential"}   # `http.<url>.proxy` and `credential.<url>.helper` also count
_REMOTE_SETTINGS = {"proxy", "receivepack", "vcs", "pushoption"}
_REPOSITORY_SCOPES = ("local", "worktree")


def push_setting(section, subsection, variable, value):
    """The name of a setting that redirects or intercepts a push, or None."""
    if section == "remote" and subsection is not None and variable in _REMOTE_SETTINGS:
        return "remote.*." + variable
    if (section, variable) not in _PUSH_SETTINGS or (subsection is not None and section not in _SUBSECTIONED):
        return None
    if (section, variable) == ("push", "gpgsign") and not git_bool_is_true(value is not None, value or ""):
        return None   # off, as `commit.gpgsign` is read
    return "%s.%s" % (section, variable) if subsection is None else "%s.*.%s" % (section, variable)


def push_config_findings(entries):
    """``(findings, refused)``: ``<scope>:<name>`` of every named setting, sorted and without repeats, and those of
    them in a scope of the repository."""
    found = {"%s:%s" % (display.ascii_text(scope)[:20], name)
             for scope, section, subsection, variable, value in entries
             for name in [push_setting(section, subsection, variable, value)] if name is not None}
    return sorted(found), sorted(item for item in found if item.partition(":")[0] in _REPOSITORY_SCOPES)


_HELPER_URL = re.compile(r"\A[A-Za-z0-9+.-]+::")
_URL = re.compile(r"\A([A-Za-z][A-Za-z0-9+.-]*)://([^/]*)")


def classify_url(url):
    """``(scheme, has_credentials)`` of a push URL, never the URL: the scheme is ``https``, ``http``, ``ssh`` (also the
    scp-like form), ``git``, ``file`` (also a path) or ``other``. A credential is a password, any user information on
    ``http``, ``https`` or ``ftp``, or user information that matches a pattern of `push-check`; a bare user name on
    ``ssh`` or ``git`` is none. A lower bound: a credential in another form (a query, a path) is not seen. A transport
    helper (``ext::...``) starts a program and is refused."""
    if _HELPER_URL.match(url):
        raise Refused("the push URL uses a transport helper that would start a program (remote:helper-transport)",
                      code="repo_selects_program")
    found = _URL.match(url)
    if found:
        kind = found.group(1).lower()
        scheme = kind if kind in ("https", "http", "ssh", "git", "file") else "other"
        authority = found.group(2)
        userinfo = authority.rpartition("@")[0] if "@" in authority else ""
        plain = kind in ("http", "https", "ftp")
    else:
        head = url.partition("/")[0]
        scheme = "ssh" if ":" in head else "file"      # `host:path` is scp-like, anything else is a path
        host = head.partition(":")[0]
        userinfo = host.rpartition("@")[0] if scheme == "ssh" and "@" in host else ""
        plain = False
    secret = any(pattern.search(userinfo) for _, pattern in _RULES)
    return scheme, bool(":" in userinfo or (plain and userinfo) or secret)


def push_url(root, entries, remote):
    """The one effective push URL of `remote` (``git remote get-url --push --all``, which applies ``pushurl`` and the
    rewrite rules), never printed. A remote with no ``url`` or ``pushurl`` is unconfigured, whatever git would do with
    its name; more than one URL is refused."""
    if not any(section == "remote" and subsection == remote and variable in ("url", "pushurl")
               for _, section, subsection, variable, _ in entries):
        raise Refused("the remote has no URL in the configuration", code="remote_unconfigured")
    listing = run(["git", "remote", "get-url", "--push", "--all", remote], root, check=False)
    if listing.returncode:
        raise Refused("git could not give the push URL of the remote", code="repository_unreadable")
    urls = listing.stdout.split("\n")
    if urls and urls[-1] == "":
        urls.pop()
    if not urls:
        raise Refused("the remote has no URL in the configuration", code="remote_unconfigured")
    if len(urls) > 1:
        raise Refused("the remote has more than one push URL", code="multiple_push_urls")
    return urls[0]


def _blank_push_facts():
    facts = {name: None for name in _PUSH_FACTS}
    facts.update((name, False) for name in _PUSH_FLAG_FACTS)
    facts.update((name, []) for name in ("push_config_findings", "push_updates", "push_deletes", "push_forced",
                                         "commit_hashes", "commit_messages", "changed_paths", "binary_paths",
                                         "submodule_paths", "findings"))
    return facts


def describe_push(argv, cwd):
    """``(errors, facts)`` of ``push <argv>``: the flags, the branch, the remote, the base and the commits ahead of
    it. Nothing is contacted and nothing is written. The facts of the later increments are empty or null."""
    facts, errors = _blank_push_facts(), []
    try:
        request = parse_push(argv)
        facts.update((name, name in request.flags) for name in _PUSH_FLAG_FACTS)
        root = git_root(cwd)
        found = repo_program_findings(root, redact=True)
        if found:
            raise Refused("this repository would make git run a program (%s)" % ", ".join(found[:10]),
                          code="repo_selects_program")
        try:
            facts["head"] = tip(root)
        except Refused as exc:
            raise Refused(str(exc), code="branch_unreadable") if exc.code == "head_unreadable" else exc
        facts["branch"] = branch = current_branch(root, facts["head"])
        if any(source not in ("HEAD", branch, "refs/heads/" + branch) for source, _, _ in request.updates):
            raise _usage("the source of an update is HEAD or the current branch")
        entries = config_entries(root)
        facts["remote"] = remote = push_remote(entries, branch, request.remote)
        facts["default_branch"] = default = remote_default_branch(root, remote)
        facts["push_config_findings"], refused = push_config_findings(entries)
        if refused:
            raise Refused("a setting of the repository would redirect or intercept the push (%s)" % ", ".join(refused),
                          code="push_config_refused")
        facts["remote_scheme"], facts["remote_url_has_credentials"] = classify_url(push_url(root, entries, remote))
        if request.deletes:
            facts["ahead"] = 0
        else:
            facts["base"] = base = push_base(root, remote, branch, default)
            facts["ahead"] = int(run(["git", "rev-list", "--count", base + "..HEAD"], root).stdout.strip())
    except Refused as exc:
        if exc.code is None:
            raise      # a refusal with no code has no place in the tables: stop with no object, as a decline
        if exc.code == "usage":
            facts = _blank_push_facts()   # arguments the grammar refuses give no fact
        errors.append((exc.code, str(exc)))
    return errors, [(name, facts[name]) for name in _PUSH_FACTS]


DESCRIBERS = {"commit": describe_commit, "push": describe_push, "remove": describe_remove}


def command_describe(argv, cwd, out, err):
    if not argv or argv[0] not in DESCRIBERS:
        raise Refused("usage: safe-git describe %s, with the arguments of that command" % "|".join(sorted(DESCRIBERS)))
    errors, facts = DESCRIBERS[argv[0]](argv[1:], cwd)
    out.write(render_description(build_description(argv[0], errors, facts)))
    return 0


# --- push-check ----------------------------------------------------------------------------------

# The narrow list of patterns the owner has used by hand, as a guard against a mistake and not as a scanner.
# Written in pieces where a whole pattern would match itself.
_RULES = (
    ("private-key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY")),
    ("aws-access-key-id", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("github-token", re.compile(r"ghp_[A-Za-z0-9]{20}|github" "_pat_[A-Za-z0-9_]{20}")),
    ("sk-key", re.compile(r"sk-[A-Za-z0-9]{20}")),
    ("slack-token", re.compile(r"xox[bp]-[0-9A-Za-z-]{10}")),
    ("jwt-shaped", re.compile(r"eyJ[A-Za-z0-9_-]{20,}\.")),
)
_HUNK = re.compile(r"@@ -\d+(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
_ESCAPES = {"a": 7, "b": 8, "f": 12, "n": 10, "r": 13, "t": 9, "v": 11, '"': 34, "\\": 92}


def _unquote(text):
    """A path as git quotes it (C-style, in double quotes, octal for other bytes); the text if it is not quoted."""
    if len(text) < 2 or text[0] != '"' or text[-1] != '"':
        return text
    body, out, index = text[1:-1], bytearray(), 0
    while index < len(body):
        char = body[index]
        if char != "\\":
            out += char.encode("utf-8", "surrogateescape")
            index += 1
        elif body[index + 1:index + 2] in _ESCAPES:
            out.append(_ESCAPES[body[index + 1]])
            index += 2
        elif re.fullmatch(r"[0-7]{3}", body[index + 1:index + 4]):
            out.append(int(body[index + 1:index + 4], 8) & 0xFF)
            index += 4
        else:
            out += b"\\"
            index += 1
    return out.decode("utf-8", "surrogateescape")


def _patch_path(text):
    """The path a `+++ ` line names, or None for a deletion."""
    if text.endswith("\t"):
        text = text[:-1]
    if text == "/dev/null":
        return None
    path = _unquote(text)
    return path[2:] if path.startswith("b/") else path


def scan_patch(text, limit):
    """The credential-looking added lines of a patch made with ``-U0``: ``(findings, cut)`` where each finding
    is ``{"path", "line", "rule"}`` and never holds the line. Hunk counts decide where a hunk ends, so an added
    line that starts like a header is read as a line."""
    findings, path, old_left, new_left, number = [], None, 0, 0, 0
    for raw in text.split("\n"):
        if old_left > 0 or new_left > 0:
            if raw.startswith("+"):
                new_left -= 1
                for rule, pattern in _RULES:
                    if path is not None and pattern.search(raw, 1):
                        if len(findings) >= limit:
                            return findings, True
                        findings.append({"path": display.ascii_text(path)[:200], "line": number, "rule": rule})
                number += 1
                continue
            if raw.startswith("-"):
                old_left -= 1
                continue
            if raw.startswith("\\"):
                continue
            old_left = new_left = 0
        if raw.startswith("diff --git "):
            path = None
        elif raw.startswith("+++ "):
            path = _patch_path(raw[4:])
        elif raw.startswith("@@"):
            found = _HUNK.match(raw)
            if found is not None:
                old_left = 1 if found.group(1) is None else int(found.group(1))
                new_left = 1 if found.group(3) is None else int(found.group(3))
                number = int(found.group(2))
    return findings, False


def secret_name(path):
    base = path.rsplit("/", 1)[-1]
    return base in (".env", "id_rsa") or base.endswith(".pem")


def parse_push_check(argv):
    """``(remote, base ref or None)`` from ``[--remote NAME] [--base REF]``, each at most once."""
    remote, base, index = "origin", None, 0
    seen = set()
    while index < len(argv):
        option = argv[index]
        if option not in ("--remote", "--base") or option in seen or index + 1 >= len(argv):
            raise Refused("usage: safe-git push-check [--remote NAME] [--base refs/heads/NAME|refs/remotes/R/NAME]")
        seen.add(option)
        value = argv[index + 1]
        if option == "--remote":
            if _REMOTE_NAME.match(value) is None:
                raise Refused("--remote must be a remote name of letters, digits and . _ - (at most 64)")
            remote = value
        else:
            if not _scan_ref(value):
                raise Refused("--base must be a full branch ref, refs/heads/NAME or refs/remotes/REMOTE/NAME")
            base = value
        index += 2
    return remote, base


def _resolved(root, ref):
    """The commit a full ref names, or None. Reads local refs only."""
    shown = run(["git", "show-ref", "--verify", "--hash", ref], root, check=False)
    value = shown.stdout.strip()
    return value if shown.returncode == 0 and _HEX40.match(value) else None


def current_branch(root, commit):
    """The short name of the branch HEAD names, given `commit`, the commit `tip` found (None when the branch has
    none). Refuses a branch with no commit, a detached HEAD and a name this helper does not read."""
    if commit is None:
        raise Refused("the current branch has no commit yet, so there is nothing to send", code="branch_unborn")
    named_head = run(["git", "symbolic-ref", "-q", "HEAD"], root, check=False)
    if named_head.returncode:
        raise Refused("HEAD is detached; switch to the branch to push", code="head_detached")
    full = named_head.stdout.strip()
    if not full.startswith("refs/heads/") or not _branch_ref(full):
        raise Refused("the branch name is not one this helper reads (ASCII letters, digits and . _ - /)",
                      code="branch_unreadable")
    return full[len("refs/heads/"):]


def remote_default_branch(root, remote):
    """The remote's default branch as `refs/remotes/<remote>/HEAD` says, or None."""
    named = run(["git", "symbolic-ref", "-q", "--short", "refs/remotes/%s/HEAD" % remote], root, check=False)
    text = named.stdout.strip()
    if named.returncode == 0 and text.startswith(remote + "/") and _branch_ref("refs/heads/" + text[len(remote) + 1:]):
        return text[len(remote) + 1:]
    return None


def push_base(root, remote, branch, default, explicit=None):
    """The commit a push of `branch` to `remote` is compared with: `explicit` when given, else the remote-tracking
    ref of the branch, else that of the remote's default branch. Refuses when none of them exists."""
    candidates = [explicit] if explicit else ["refs/remotes/%s/%s" % (remote, branch)]
    if not explicit and default is not None:
        candidates.append("refs/remotes/%s/%s" % (remote, default))
    base = next((value for value in (_resolved(root, ref) for ref in candidates) if value), None)
    if base is None:
        raise Refused("no base to compare with; tried %s" % ", ".join(candidates), code="base_unresolved")
    return base


def command_push_check(argv, cwd, out, err):
    """Report what a push of the current branch would send, from local refs only; it never contacts a remote and
    changes nothing. One JSON line: ``remote``, ``branch``, ``target`` (the branch a push of HEAD would update),
    ``default_branch`` (or null), ``base``, ``ahead``, ``changed_paths``, ``findings`` and ``truncated``."""
    remote, explicit = parse_push_check(argv)
    root = git_root(cwd)
    found = repo_program_findings(root)
    if found:
        raise Refused("this repository would make git run a program (%s); check by hand" % ", ".join(found[:10]))
    branch = current_branch(root, tip(root))
    default = remote_default_branch(root, remote)
    base = push_base(root, remote, branch, default, explicit)
    span = base + "..HEAD"
    ahead = run(["git", "rev-list", "--count", span], root).stdout.strip()
    names_text, cut_names = run_capped(["git", "diff", "--name-only", "-z", "--no-renames", "--diff-filter=d", span],
                                       root, MAX_SCAN, separator="\0")
    shape = ["--no-ext-diff", "--no-textconv", "--no-renames", "--no-color", "-U0", "--text",
             "--ignore-submodules=all", "--src-prefix=a/", "--dst-prefix=b/"]
    # Each commit on its own, so a secret added and taken out again inside the range is still seen, and the net
    # change, which also holds what a merge brought in. A changed submodule is not entered: that would start
    # the program its own configuration names.
    history, cut_history = run_capped(["git", "log", "--no-merges", "-p", "--format=", "--no-show-signature"]
                                      + shape + [span], root, MAX_SCAN)
    patch, cut_patch = run_capped(["git", "diff"] + shape + [span], root, MAX_SCAN)
    paths = [item for item in names_text.split("\0") if item]
    findings, cut_findings = scan_patch(history, MAX_FINDINGS)
    more, cut_more = scan_patch(patch, MAX_FINDINGS)
    for item in more:
        if item not in findings:
            if len(findings) >= MAX_FINDINGS:
                cut_findings = True
                break
            findings.append(item)
    cut_findings = cut_findings or cut_more
    for item in paths:
        if secret_name(item):
            if len(findings) >= MAX_FINDINGS:
                cut_findings = True
                break
            findings.append({"path": display.ascii_text(item)[:200], "line": None, "rule": "secret-file-name"})
    report = {"remote": remote, "branch": branch, "target": branch, "default_branch": default, "base": base,
              "ahead": int(ahead), "changed_paths": [display.ascii_text(item)[:200] for item in paths[:MAX_CHANGED]],
              "findings": findings, "truncated": bool(cut_names or cut_history or cut_patch or cut_findings
                                or len(paths) > MAX_CHANGED)}
    out.write(json.dumps(report) + "\n")
    return 0


COMMANDS = {"commit": command_commit, "describe": command_describe, "remove": command_remove,
            "push-check": command_push_check}


def main(argv, out, err, cwd):
    """Run one subcommand from `cwd`. Returns the exit code."""
    try:
        if not argv or argv[0] not in COMMANDS:
            raise Refused("usage: safe-git %s, with their options" % "|".join(sorted(COMMANDS)))
        return COMMANDS[argv[0]](argv[1:], cwd, out, err)
    except Refused as exc:
        err.write("refused: %s\n" % exc)
        return 1
    except OSError as exc:
        err.write("failed: %s\n" % shown(exc.strerror or exc))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], sys.stdout, sys.stderr, os.getcwd()))
