#!/usr/bin/env python3
"""The groundwork reference check: the tracked reference index against the files git tracks.

It is a kit helper (kit API 1): one file over the kit's no-follow reader, started by ``wb check`` from the
project root. The rules are in ``docs/specs/groundwork.md`` ("Indexes") and
``docs/decisions/2026-10-21-reference-index-format.md``. It prints ``problem:`` and ``warning:`` lines for:

* an entry whose file is not tracked, is missing, is not a regular file (a link in place of a file
  among them), or whose content does not hash to the recorded value;
* a tracked file under ``docs/references/`` that the index has no entry for;
* an index that is missing, untracked or not in its canonical form;
* a title or note that names a path into ``.workbench/local``, which a tracked file may not do;
* as warnings, a reference over 2 MiB, the indexed references over 50 MiB in all, and an entry
  with no license.

``index.json`` and the area's ``README.md`` are metadata, not references. What git tracks is read from
``.git/index`` by the kit, so no program runs. The index is strict: it accepts nothing but the
serializer's own output, so a duplicate key, NaN, a fraction, a non-printable character, an unknown or
missing field, a repeated or unsorted file or a different layout is refused. A message names the entry (by
its place in the list) and the field and never repeats a value, because the value is hostile text. The
bytes read are bounded, and passing the bound is a problem that says what was not looked at. The helper
changes nothing, and a project with no references gets no line.
"""

import datetime
import hashlib
import json
import os
import re
import sys
import urllib.parse

from wbkit import display, gitindex, jsonstrict, safefs

PATH = "docs/references/index.json"
AREA = "docs/references"
LOCAL_AREA = ".workbench/local/refs"
METADATA = ("index.json", "README.md")
FORMAT = 1
MAX_BYTES = 1024 * 1024
MAX_ENTRIES = 5000

TOP_KEYS = ("entries", "format")
ENTRY_KEYS = ("file", "license", "notes", "retrieved", "sha256", "title", "url", "version")

# The longest value of each text field; ``file`` is bounded by the path rule.
LIMITS = {"title": 300, "url": 2048, "license": 128, "version": 128, "notes": 2000}
# A field that may be empty: a hand-added reference may have no license, version or notes. The
# check warns about a missing license; it does not forbid it.
OPTIONAL = ("license", "version", "notes")

_HEX64 = re.compile(r"^[0-9a-f]{64}\Z")
_DATE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}\Z")
_URL = re.compile(r"^https?://[^\s/?#]+[^\s]*\Z")


def _line(value):
    return json.dumps(value, sort_keys=True, separators=(", ", ": "), ensure_ascii=True)


class RefIndexError(Exception):
    """The index, or the document to be written, does not have the required form."""


def _fail(position, field, reason):
    where = "the index" if position is None else "entry %d" % position
    raise RefIndexError("%s: %s %s" % (where, field, reason))


def _text(position, entry, field):
    value = entry[field]
    limit = LIMITS[field]
    if not isinstance(value, str):
        _fail(position, field, "is not text")
    if not value.isprintable():
        _fail(position, field, "has a non-printable character")
    if len(value) > limit:
        _fail(position, field, "is longer than %d characters" % limit)
    if not value and field not in OPTIONAL:
        _fail(position, field, "is empty")
    return value


def _file(position, value, area):
    if not isinstance(value, str):
        _fail(position, "file", "is not text")
    try:
        safefs.validate_relpath(value)
    except safefs.SafeFsError as exc:
        _fail(position, "file", "is not a safe relative path (%s)" % _reason(exc))
    # Exact, not folded: a name that only folds into the area (`docs/REFERENCES`, a long s) is a
    # different directory on a filesystem that tells letters apart.
    prefix = area + "/"
    if not value.startswith(prefix) or value == prefix:
        _fail(position, "file", "is not a file under %s" % area)
    if value[len(prefix):] in METADATA:
        _fail(position, "file", "names the index or the README, which are not references")


def _reason(exc):
    # The path rule quotes the path it refused; the field is named, so the quote is dropped.
    return str(exc).split(":", 1)[0]


def _fields(item, expected, position):
    # Unlike the manifest's key check, this shows no unexpected key: it is hostile text.
    if not isinstance(item, dict):
        _fail(position, "the entry", "is not an object")
    if set(item) != set(expected):
        _fail(position, "the fields", "are not exactly %s" % ", ".join(expected))


def _shape(position, entry, area):
    _fields(entry, ENTRY_KEYS, position)
    _file(position, entry["file"], area)
    for field in LIMITS:
        _text(position, entry, field)
    if not _URL.match(entry["url"]):
        _fail(position, "url", "is not an http or https address")
    retrieved = entry["retrieved"]
    if not isinstance(retrieved, str) or not _DATE.match(retrieved):
        _fail(position, "retrieved", "is not a date as YYYY-MM-DD")
    try:
        datetime.date(int(retrieved[:4]), int(retrieved[5:7]), int(retrieved[8:]))
    except ValueError:
        _fail(position, "retrieved", "is not a real date")
    if not isinstance(entry["sha256"], str) or not _HEX64.match(entry["sha256"]):
        _fail(position, "sha256", "is not a SHA-256 in lowercase hex")


def check_document(document, area=AREA):
    """Raise RefIndexError unless `document` has exactly the shape the serializer writes."""
    _fields(document, TOP_KEYS, None)
    version = document["format"]
    if isinstance(version, bool) or not isinstance(version, int) or version != FORMAT:
        _fail(None, "format", "is not %d" % FORMAT)
    entries = document["entries"]
    if not isinstance(entries, list):
        _fail(None, "entries", "is not a list")
    if len(entries) > MAX_ENTRIES:
        _fail(None, "entries", "has more than %d entries" % MAX_ENTRIES)
    for position, entry in enumerate(entries):
        _shape(position, entry, area)
    keys = [entry["file"].encode("utf-8") for entry in entries]
    if keys != sorted(keys):
        raise RefIndexError("the index: entries are not sorted")
    if len(set(keys)) != len(keys):
        raise RefIndexError("the index: entries repeat an entry")
    try:
        safefs.check_tree_paths([e["file"] for e in entries])
    except safefs.SafeFsError as exc:
        raise RefIndexError("the index: %s" % _reason(exc))


def serialize(document, area=AREA):
    """The canonical bytes of `document`; raises RefIndexError for anything not in shape."""
    check_document(document, area)
    entries = document["entries"]
    if entries:
        body = ",\n".join("    " + _line(entry) for entry in entries)
        listed = '  "entries": [\n%s\n  ]' % body
    else:
        listed = '  "entries": []'
    data = ("{\n%s,\n  \"format\": %d\n}\n" % (listed, FORMAT)).encode("ascii")
    if len(data) > MAX_BYTES:
        raise RefIndexError("the index is larger than %d bytes" % MAX_BYTES)
    return data


def parse(data, area=AREA):
    """The document in canonical `data`; raises RefIndexError for anything else."""
    if not isinstance(data, bytes):
        raise RefIndexError("the index is not bytes")
    if len(data) > MAX_BYTES:
        raise RefIndexError("the index is larger than %d bytes" % MAX_BYTES)
    try:
        document = jsonstrict.parse_object(data, MAX_BYTES)
    except ValueError as exc:
        raise RefIndexError("the index is not valid: %s" % exc)
    check_document(document, area)
    if serialize(document, area) != data:
        raise RefIndexError("the index is not in its canonical form")
    return document


FILE_WARN = 2 * 1024 * 1024
FOLDER_WARN = 50 * 1024 * 1024
MAX_READ = 128 * 1024 * 1024
MAX_LISTED = 50
LOCAL = ".workbench/local"


def _shown(path):
    return display.ascii_text(path)[:120]


def _split(path):
    """The name below the area for a tracked `path`, or None when it is outside the area."""
    prefix = AREA + "/"
    if not path.startswith(prefix):
        return None
    return path[len(prefix):]


def _is_metadata(rest):
    # Exact, as in the reader: a file that differs in letter case is a file of its own on a
    # filesystem that tells letters apart, and it needs an entry.
    return rest in METADATA


def _tracked_files(tracked):
    return sorted(path for path in tracked.files
                  if _split(path) is not None and not _is_metadata(_split(path)))


def _read_index(held, tracked, problems):
    """The parsed index, or None with the reason added to `problems`."""
    path = PATH
    try:
        data = held.read_if_present(path, safefs.MAX_FILE_BYTES)
    except safefs.SafeFsError as exc:
        problems.append("%s: cannot be read: %s" % (path, display.ascii_text(str(exc))[:160]))
        return None
    if data is None:
        return None
    if path not in tracked.files:
        problems.append("%s: exists but git does not track it, and the tracked index is a tracked "
                        "file" % path)
        return None
    try:
        return parse(data)
    except RefIndexError as exc:
        problems.append("%s: %s" % (path, display.ascii_text(str(exc))[:200]))
        return None


def _flat(text):
    """`text` as a path would be read: decoded, folded, with separators run together. A best-effort
    guard against a slip, not a boundary: a lookalike character defeats it."""
    text = " ".join(urllib.parse.unquote(text).casefold().replace("\\", "/").split())
    text = re.sub(r" ?/ ?", "/", text)
    while "//" in text or "/./" in text:
        text = text.replace("//", "/").replace("/./", "/")
    return text


def _file_entry(held, tracked, entry, spent, problems, warnings):
    """Check one entry against its file; `spent` is the running count of bytes read."""
    name = _shown(entry["file"])
    for field in ("title", "notes"):
        if LOCAL in _flat(entry[field]):
            problems.append("%s: its %s names a path into %s, which is not tracked; cite an "
                            "untracked reference by URL, date and hash" % (name, field, LOCAL))
    if not entry["license"]:
        warnings.append("%s: no license is recorded" % name)
    if entry["file"] not in tracked.files:
        problems.append("%s: the index has an entry for it, but git does not track it" % name)
        return
    if entry["file"] in tracked.links:
        problems.append("%s: git tracks a link in place of the file" % name)
        return
    if spent[0] >= MAX_READ:
        spent[1] = True
        return
    try:
        data = held.read_if_present(entry["file"], safefs.MAX_FILE_BYTES)
    except safefs.SafeFsError as exc:
        problems.append("%s: cannot be read: %s" % (name, display.ascii_text(str(exc))[:160]))
        return
    if data is None:
        problems.append("%s: is missing" % name)
        return
    spent[0] += len(data)
    spent[2] += len(data)
    if hashlib.sha256(data).hexdigest() != entry["sha256"]:
        problems.append("%s: its content differs from the hash in the index" % name)
    if len(data) > FILE_WARN:
        warnings.append("%s: %d bytes, over the %d a reference file should not exceed; keep it "
                        "untracked" % (name, len(data), FILE_WARN))


def examine(held, tracked):
    """``(problems, warnings)`` for the reference index of the project `held` is open on, given what
    git tracks. Both are empty for a project with no references."""
    problems, warnings = [], []
    files = _tracked_files(tracked)
    document = _read_index(held, tracked, problems)
    if document is None:
        if files and not problems:
            problems.append("%s: there is no index, but git tracks %d reference file%s"
                            % (PATH, len(files), "" if len(files) == 1 else "s"))
        elif files:
            problems.append("%d tracked reference file%s %s not compared with an index"
                            % (len(files), "" if len(files) == 1 else "s",
                               "was" if len(files) == 1 else "were"))
        return problems, warnings
    spent = [0, False, 0]  # bytes read, whether the bound was passed, bytes of indexed references
    indexed = set()
    for entry in document["entries"]:
        indexed.add(entry["file"])
        _file_entry(held, tracked, entry, spent, problems, warnings)
    if spent[1]:
        problems.append("more than %d bytes of references; the rest were not looked at" % MAX_READ)
    if spent[2] > FOLDER_WARN:
        warnings.append("%s: the indexed references total %d bytes, over the %d a project should "
                        "keep" % (AREA, spent[2], FOLDER_WARN))
    lacking = [path for path in files if path not in indexed]
    for path in lacking[:MAX_LISTED]:
        more = "" if safefs.relpath_ok(path) else \
            " (its name cannot be written in an index; rename the file)"
        problems.append("%s: git tracks it, but the index has no entry for it%s"
                        % (_shown(path), more))
    if len(lacking) > MAX_LISTED:
        problems.append("%d more tracked reference files have no entry in the index"
                        % (len(lacking) - MAX_LISTED))
    return problems, warnings


MAX_LINES = 200


def main():
    try:
        with safefs.Root(os.getcwd(), "project root") as held:
            try:
                tracked = gitindex.read(held)
            except gitindex.GitIndexError as exc:
                problems, warnings = ["the git index cannot be read, so the references were not "
                                      "compared: %s" % display.ascii_text(str(exc))[:160]], []
            else:
                problems, warnings = examine(held, tracked)
    except (safefs.SafeFsError, OSError) as exc:
        problems, warnings = ["the project cannot be read: %s" % display.ascii_text(str(exc))[:160]], []
    lines = ["problem: " + p for p in problems] + ["warning: " + w for w in warnings]
    if len(lines) > MAX_LINES:
        lines = lines[:MAX_LINES - 1] + ["problem: more findings are not listed"]
    for line in lines:
        sys.stdout.write(display.ascii_text(line) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
