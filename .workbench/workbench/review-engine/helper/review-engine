#!/usr/bin/env python3
"""The review-engine helper: keeps a review of a plan, a spec, a roadmap or a decision record in a sealed state.

It is one file that imports the standard library and the workbench kit (``wbkit``); the launcher runs a
private copy of it through the kit runner with nothing beside it.

    review-engine status <document>      show a review
    review-engine convergence <document> say whether the last review of a plan converged (read-only; the
                                         installer asks it for a delegated plan approval)
    review-engine init <document>        make an empty review; no model is asked
    review-engine review-plan|review-spec|review-roadmap|review-adr <document>
                                         run one round: ask a model, through the bridge the project names,
                                         and keep what it found
    review-engine decide <document> <finding> applied|rejected [--reason <text>]
                                         record what was done about a finding, once
    review-engine amend|extend|reset|archive <document> ...    (the owner's) change a decision, the bound or
                                         the window, or close the review
    review-engine prune [--apply]        (the owner's) list, or delete, closed reviews past their retention
    review-engine preview extend <document> <n>
                                         say what an extension would change and print its digest (read-only)
    review-engine extend <document> <n> --digest <digest>
                                         extend only if the digest is that of the review now

The contract is ``docs/specs/review-engine.md``. A review lives in the project, in
``.workbench/workbench/review-engine/<key>/``, and is sealed with a key kept in the guarded store, together with
a mark of the most it has ever sealed, so that an edited or restored state is seen. Every command but ``preview``
prints one JSON object, or a ``refused:`` line and nothing on standard output; ``preview`` prints lines of text. Whatever is read from the project is
data: it is parsed strictly, bounded and checked, never run and never believed.
"""

import calendar
import collections
import contextlib
import errno
import fcntl
import hashlib
import hmac
import json
import os
import re
import stat
import sys
import time
import unicodedata

from wbkit import call, display, jsonstrict, project, safefs

FORMAT = 1
KINDS = (("plan", "docs/plans"), ("spec", "docs/specs"), ("roadmap", "docs/roadmaps"), ("adr", "docs/decisions"))
MAX_DOCUMENT = 1048576
MAX_STATE = 4194304
MAX_STRING = 4000
MAX_COUNT = 2147483647
MAX_ROUNDS = 1000
MAX_DECISIONS = 5000
DEFAULT_BOUND = 3
CEILING = 5
KEY_BYTES = 32
NAMESPACE = ".workbench/workbench/review-engine"
STORE_NAME = "review-engine"
USAGE = ("usage: review-engine status|init|convergence|review-plan|review-spec|review-roadmap|review-adr|reset|archive "
         "<document>, "
         "decide|amend <document> <finding> applied|rejected [--reason <text>], "
         "extend <document> <1 to 5> [--digest <digest>], preview extend <document> <1 to 5>, or prune [--apply]")
FIELDS = {"format", "kind", "path", "window", "rounds", "decisions", "closed", "generation", "seal"}
CHOICES = ("applied", "rejected")
DECISION_FIELDS = {"finding", "choice", "reason", "at", "earlier"}
EARLIER_FIELDS = {"choice", "reason", "at"}
FINDING = r"R[1-9][0-9]{0,3}-F[1-9][0-9]{0,2}"
MAX_REASON = 2000
MAX_EARLIER = 20
DIGEST_CHARS = 32
DIGEST = r"[0-9a-f]{32}"
RETENTION_DAYS = 90
REVIEW_DIR = re.compile(r"(plan|spec|roadmap|adr)-[0-9a-f]{16}")
FILE_NAME = re.compile(r"state\.json|ledger\.md|schema\.json|round-[1-9][0-9]{0,3}\.json")
ROUND_FIELDS = {"n", "file", "sha256", "document_sha256", "at", "bridge", "requested", "model", "verdict", "reading",
                "mismatch", "usage", "findings"}
USAGE_FIELDS = ("input_tokens", "output_tokens", "total_tokens")
ROUND_COMMANDS = {"review-" + name: name for name, _ in KINDS}
_TIME = r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
_HEX = r"[0-9a-f]{64}"
_MODEL = r"[A-Za-z0-9][A-Za-z0-9._:-]{0,63}"

SETTING = ".workbench/review.json"
CAPABILITY = "model-bridge"
MAX_SETTING = 4096
MAX_PROMPT = 65536
MAX_REPLY = 262144
MAX_BRIDGE_OBJECT = 2000000
MAX_ROUND_FILE = 1048576
MAX_FINDINGS = 100
BRIDGE_TIMEOUT = 600  # the bridge's own limit; the engine's must be longer, so the bridge can report `timeout`
ENGINE_LIMIT = 660
SEVERITIES = ("blocker", "major", "minor", "nit")
MEANINGFUL = ("blocker", "major")
VERDICTS = ("changes_needed", "no_meaningful_changes")
EFFORTS = ("low", "medium", "high")
